<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.StudioMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="40"
    Height="40"
    MinWidth="40"
    MinHeight="40">
    <Button
        x:Name="Inner"
        Width="40"
        Height="40"
        MinWidth="40"
        MinHeight="40"
        Padding="0"
        Click="OnInnerClick"
        Style="{StaticResource StudioButtonSecondary}">
        <Grid>
            <Image
                x:Name="CustomImage"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <FontIcon
                x:Name="GlyphIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="Letter"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HeirloomSans}"
                FontSize="14"
                FontWeight="SemiBold" />
        </Grid>
    </Button>
</UserControl>
