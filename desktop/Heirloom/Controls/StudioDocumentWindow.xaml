<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.StudioDocumentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="480"
    MinHeight="36"
    PointerCaptureLost="OnPointerReleased"
    PointerMoved="OnPointerMoved"
    PointerReleased="OnPointerReleased">
    <Border
        x:Name="Shell"
        Background="{StaticResource HeirloomGlassBrush}"
        BorderBrush="{StaticResource HeirloomBorderBrush}"
        BorderThickness="1"
        CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border
                CornerRadius="2,2,0,0"
                Background="{StaticResource HeirloomDocTitleBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,0,0,1"
                PointerMoved="OnPointerMoved"
                PointerPressed="OnChromePressed"
                PointerReleased="OnPointerReleased">
                <Grid MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,8,12,8" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="TitleBlock"
                            Style="{StaticResource StudioDocumentTitle}"
                            Text="{x:Bind TitleText, Mode=OneWay}" />
                        <TextBlock
                            x:Name="SubtitleBlock"
                            Style="{StaticResource StudioCaption}"
                            Text="{x:Bind SubtitleText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="40"
                            Click="OnHelp"
                            Style="{StaticResource StudioButtonQuiet}"
                            ToolTipService.ToolTip="Explain this window">
                            <FontIcon
                                FontSize="11"
                                Foreground="{StaticResource HeirloomTextMutedBrush}"
                                Glyph="&#xE897;" />
                        </Button>
                        <Button
                            Width="32"
                            Height="40"
                            Click="OnMin"
                            Style="{StaticResource StudioButtonQuiet}"
                            ToolTipService.ToolTip="Minimize">
                            <FontIcon
                                FontSize="11"
                                Foreground="{StaticResource HeirloomTextMutedBrush}"
                                Glyph="&#xE921;" />
                        </Button>
                        <Button
                            Width="32"
                            Height="40"
                            Click="OnMax"
                            Style="{StaticResource StudioButtonQuiet}"
                            ToolTipService.ToolTip="Maximize">
                            <FontIcon
                                FontSize="11"
                                Foreground="{StaticResource HeirloomTextMutedBrush}"
                                Glyph="&#xE922;" />
                        </Button>
                        <Button
                            Click="OnClose"
                            Style="{StaticResource StudioButtonClose}"
                            ToolTipService.ToolTip="Close">
                            <FontIcon
                                FontSize="11"
                                Foreground="{StaticResource HeirloomTextSecondaryBrush}"
                                Glyph="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="MenuHost"
                Grid.Row="1"
                Background="{StaticResource HeirloomMenuStripBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,0,0,1">
                <ContentPresenter Content="{x:Bind MenuBarContent, Mode=OneWay}" />
            </Border>

            <Border
                x:Name="OptionsHost"
                Grid.Row="2"
                Background="{StaticResource HeirloomOptionsStripBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
                <ContentPresenter Content="{x:Bind OptionsContent, Mode=OneWay}" />
            </Border>

            <Grid x:Name="BodyHost" Grid.Row="3">
                <ContentPresenter Content="{x:Bind Body, Mode=OneWay}" />
            </Grid>

            <Border
                Grid.Row="4"
                Background="{StaticResource HeirloomStatusBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,2,2"
                PointerMoved="OnPointerMoved"
                PointerPressed="OnResizePressed"
                PointerReleased="OnPointerReleased">
                <Grid>
                    <TextBlock
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource StudioCaption}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{StaticResource HeirloomTextMutedBrush}"
                        Glyph="&#xE76F;" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
