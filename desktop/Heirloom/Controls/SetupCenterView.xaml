<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.SetupCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource HeirloomBgSurfaceBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="0,0,1,0" Padding="16,14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource StudioOverline}" Text="Checklist" />
                <ListView x:Name="Steps" Grid.Row="1" SelectionMode="None" Style="{StaticResource StudioPlainList}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource StudioText}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{Binding Status}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource StudioMuted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="RepairButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnRepair" Content="Repair" Style="{StaticResource StudioButtonQuiet}" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="20,16">
            <StackPanel Spacing="16" MaxWidth="640">
                <TextBlock Style="{StaticResource StudioOverline}" Text="Open the right page" />
                <ComboBox x:Name="Guides" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectionChanged="OnGuide" />
                <TextBlock x:Name="GuidePlain" Style="{StaticResource StudioText}" TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left" Click="OnOpen" Content="Open this page" Style="{StaticResource StudioButtonPrimary}" />
                <TextBlock Style="{StaticResource StudioOverline}" Text="Paste and test" />
                <PasswordBox x:Name="SecretBox" PlaceholderText="Paste a key. It stays masked." />
                <TextBox x:Name="BaseUrl" PlaceholderText="Home Assistant address, if this step asks" />
                <Button HorizontalAlignment="Left" Click="OnPaste" Content="Test and save" Style="{StaticResource StudioButtonQuiet}" />
                <TextBlock x:Name="SecretLine" Style="{StaticResource StudioMuted}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioOverline}" Text="Restore from backup" />
                <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Use the folder of gpg parts, SHA256SUMS, and MANIFEST, or a plain copy of the vault. The full backup is applied first, then each incremental. The passphrase is not saved." />
                <TextBox x:Name="BackupFolder" PlaceholderText="Folder, such as D:\TwinBackup" />
                <TextBox x:Name="RestoreDest" PlaceholderText="Where to put it on this PC" />
                <PasswordBox x:Name="Passphrase" PlaceholderText="Backup passphrase" PasswordChanged="OnPassphrase" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnVerify" Content="Check the files" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Click="OnRestore" Content="Restore" Style="{StaticResource StudioButtonPrimary}" />
                </StackPanel>
                <TextBlock x:Name="RestoreLine" Style="{StaticResource StudioText}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
