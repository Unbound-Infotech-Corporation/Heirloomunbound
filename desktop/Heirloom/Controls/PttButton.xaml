<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.PttButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="168"
    MinHeight="40"
    Height="40"
    IsTabStop="True"
    UseSystemFocusVisuals="True">
    <Button
        x:Name="Face"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AllowFocusOnInteraction="False"
        AutomationProperties.Name="Hold to talk"
        ClickMode="Press"
        IsTabStop="False"
        Style="{StaticResource StudioButtonPrimary}">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                x:Name="Mic"
                VerticalAlignment="Center"
                FontSize="14"
                Glyph="&#xE720;" />
            <TextBlock
                x:Name="Label"
                VerticalAlignment="Center"
                FontFamily="{StaticResource HeirloomSans}"
                FontSize="13"
                FontWeight="SemiBold"
                Text="Hold to talk" />
        </StackPanel>
    </Button>
</UserControl>
