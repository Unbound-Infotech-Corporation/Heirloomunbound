<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.HelpInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{StaticResource HeirloomDockBrush}"
        BorderBrush="{StaticResource HeirloomBorderBrush}"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Padding="14,10"
                Background="{StaticResource HeirloomBgElevatedBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource StudioCaption}" Text="LOOK HERE" />
                    <TextBlock
                        x:Name="ModeText"
                        Style="{StaticResource StudioMuted}"
                        Text="Resting" />
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource StudioDocumentTitle}"
                        TextWrapping="Wrap"
                        Text="Hover inspector" />
                    <TextBlock
                        x:Name="PlaceText"
                        Style="{StaticResource StudioCaption}"
                        TextWrapping="Wrap"
                        Text="" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="14,12">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="SummaryText"
                        Style="{StaticResource StudioText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="BodyText"
                        Style="{StaticResource StudioMuted}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource StudioCaption}" Text="RELATED" />
                    <ItemsControl x:Name="RelatedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnRelatedClick"
                                    Content="{Binding Title}"
                                    Style="{StaticResource StudioButtonQuiet}"
                                    Tag="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                Grid.Row="2"
                Padding="10,8"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,1,0,0"
                Spacing="6">
                <Button
                    x:Name="PinButton"
                    Click="OnPin"
                    Content="Pin this"
                    Style="{StaticResource StudioButtonSecondary}" />
                <Button
                    Click="OnGlossary"
                    Content="Open glossary"
                    Style="{StaticResource StudioButtonQuiet}" />
                <Button
                    Click="OnHide"
                    Content="Hide panel"
                    Style="{StaticResource StudioButtonQuiet}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
