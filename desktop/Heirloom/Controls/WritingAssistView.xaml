<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.WritingAssistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,16" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource StudioOverline}" Text="Your words" />
            <TextBox
                x:Name="Draft"
                Grid.Row="1"
                AcceptsReturn="True"
                FontSize="16"
                PlaceholderText="Write here. Underlines show under the suggestions."
                TextChanged="OnText"
                TextWrapping="Wrap" />
            <ItemsControl x:Name="Underlines" Grid.Row="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="16"
                            Text="{Binding Text}"
                            TextDecorations="{Binding Decoration}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Click="OnFix" Content="Fix" Style="{StaticResource StudioButtonPrimary}" />
                <Button Click="OnShorter" Content="Shorter" Style="{StaticResource StudioButtonQuiet}" />
                <Button Click="OnFriendlier" Content="Friendlier" Style="{StaticResource StudioButtonQuiet}" />
                <Button Click="OnFormal" Content="More formal" Style="{StaticResource StudioButtonQuiet}" />
                <Button Click="OnApprove" Content="Approve paste" Style="{StaticResource StudioButtonQuiet}" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Style="{StaticResource StudioOverline}" Text="Dictionary" />
            <TextBox x:Name="Word" PlaceholderText="A word" TextChanged="OnWord" />
            <TextBlock x:Name="Definition" Style="{StaticResource StudioText}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource StudioOverline}" Text="Any app" />
            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Ctrl+Alt+H checks the words you highlighted in another app. Nothing is pasted back until you approve it here or on the card." />
            <TextBlock x:Name="PasteLine" Style="{StaticResource StudioCaption}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
