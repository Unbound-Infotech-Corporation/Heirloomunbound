<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Heirloom.Controls.CodeWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="168" />
        </Grid.RowDefinitions>
        <Border Padding="12,8" Background="{StaticResource HeirloomDocTitleBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="CoderLine" VerticalAlignment="Center" Style="{StaticResource StudioCaption}" Text="Local coder" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnGit" Content="Git status" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Click="OnCommit" Content="Commit" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Click="OnAgent" Content="Agent" Style="{StaticResource StudioButtonPrimary}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnSpacing="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource HeirloomBgSurfaceBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StudioOverline}" Text="Files" />
                    <ListView x:Name="Files" Grid.Row="1" SelectionChanged="OnFile" Style="{StaticResource StudioPlainList}" />
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <WebView2 x:Name="Monaco" />
                <TextBox
                    x:Name="Editor"
                    AcceptsReturn="True"
                    FontFamily="{StaticResource HeirloomMono}"
                    FontSize="14"
                    PlaceholderText="Monaco loads in this pane. You can also type here."
                    TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource HeirloomBgSurfaceBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="1,0,0,0" Padding="12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StudioOverline}" Text="Review" />
                    <ListView x:Name="Hunks" Grid.Row="1" SelectionMode="None" Style="{StaticResource StudioPlainList}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10" Spacing="4">
                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{Binding Id}" />
                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{Binding Before}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource StudioText}" Text="{Binding After}" TextWrapping="Wrap" />
                                    <Button Click="OnAccept" Content="Accept" Tag="{Binding Id}" Style="{StaticResource StudioButtonQuiet}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,8" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource StudioOverline}" Text="Terminal" />
                <TextBlock x:Name="Term" Grid.Row="1" Style="{StaticResource StudioMuted}" TextWrapping="Wrap" />
                <Grid Grid.Row="2">
                    <TextBox x:Name="Command" PlaceholderText="Command" />
                    <Button HorizontalAlignment="Right" Click="OnRun" Content="Confirm and run" Style="{StaticResource StudioButtonPrimary}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
