                    <TextBlock Style="{StaticResource StudioCaption}" Text="COMMAND PALETTE" />
                    <TextBox PlaceholderText="speak …  ·  capture …  ·  mixer  ·  interview" Text="{x:Bind ViewModel.CommandQuery, Mode=TwoWay}" />
                    <Button Command="{x:Bind ViewModel.RunPaletteCommand}" Content="Run" Style="{StaticResource StudioButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>

