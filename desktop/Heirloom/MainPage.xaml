                            <ListView
                                Grid.Row="2"
                                ItemsSource="{x:Bind ViewModel.Glossary.Results}"
                                SelectedItem="{x:Bind ViewModel.Glossary.Selected, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:HelpTopic">
                                        <StackPanel Margin="0,6">
                                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Kind}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <ScrollViewer Grid.Column="1" Padding="8,0">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource StudioWordmark}" Text="{x:Bind ViewModel.Glossary.SelectedTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource StudioText}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Glossary.SelectedSummary, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Glossary.SelectedBody, Mode=OneWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="480"
                    Canvas.Left="48"
                    Canvas.Top="48"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="kitchensink"
                    TitleText="Control kit"
                    Visibility="Collapsed">
                    <ScrollViewer Padding="28">
                        <StackPanel MaxWidth="640" Spacing="16">
                            <TextBlock Style="{StaticResource StudioWordmark}" Text="Control kit" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.KitchenSink.Hero}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Primary" Style="{StaticResource StudioButtonPrimary}" />
                                <Button Content="Secondary" Style="{StaticResource StudioButtonSecondary}" />
                                <Button Content="Quiet" Style="{StaticResource StudioButtonQuiet}" />
                                <Button Content="Destructive" Style="{StaticResource StudioButtonDanger}" />
                                <Button Content="Disabled" IsEnabled="False" Style="{StaticResource StudioButtonPrimary}" />
                            </StackPanel>
                            <controls:PttButton HorizontalAlignment="Left" />
                            <Slider Width="280" Foreground="{StaticResource HeirloomGoldBrush}" Value="72" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:StudioDocumentWindow>
            </Canvas>

            <Border
                x:Name="InspectorSplit"
                Grid.Row="1"
                Grid.Column="2"
                Width="6"
                Background="Transparent"
                PointerMoved="OnInspectorSplitMoved"
                PointerPressed="OnInspectorSplitPressed"
                PointerReleased="OnInspectorSplitReleased">
                <Border Width="1" HorizontalAlignment="Center" Background="{StaticResource HeirloomGoldDeepBrush}" />
            </Border>

            <controls:HelpInspector
                x:Name="Inspector"
                Grid.Row="1"
                Grid.Column="3"
                GlossaryRequested="OnInspectorGlossary"
                HideRequested="OnInspectorHide"
                TopicRequested="OnInspectorTopic" />

            <controls:DockRail
                x:Name="RightRail"
                Grid.Row="1"
                Grid.Column="4"
                DocumentRequested="OnDockDocument"
                Edge="right"
                EdgeDropped="OnDockEdgeDropped"
                ItemsSource="{x:Bind ViewModel.Dock}"
                ActiveId="{x:Bind ViewModel.ActiveDocumentId, Mode=OneWay}"
                SizeChangedByUser="OnDockSizeChanged"
                Visibility="Collapsed" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{StaticResource HeirloomStatusBrush}"
            BorderBrush="{StaticResource HeirloomBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                <TextBlock
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="{x:Bind ViewModel.WindowLine, Mode=OneWay}" />
            </Grid>
        </Border>

        <Grid
            x:Name="Palette"
            Grid.RowSpan="3"
            Background="#99000000"
            Visibility="Collapsed">
            <Border
                Width="560"
                Margin="0,80,0,0"
                Padding="16"
                VerticalAlignment="Top"
                Background="{StaticResource HeirloomBgElevatedBrush}"
                BorderBrush="{StaticResource HeirloomGoldBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource StudioCaption}" Text="COMMAND PALETTE" />
                    <TextBox PlaceholderText="speak …  ·  capture …  ·  mixer  ·  interview" Text="{x:Bind ViewModel.CommandQuery, Mode=TwoWay}" />
                    <Button Command="{x:Bind ViewModel.RunPaletteCommand}" Content="Run" Style="{StaticResource StudioButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="FirstRun"
            Grid.RowSpan="3"
            Background="#CC121110"
            Visibility="Collapsed">
            <Border
                Width="680"
                Padding="28"
                Background="{StaticResource HeirloomBgSurfaceBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind ViewModel.FirstRun.StepCaption, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource StudioWordmark}" Text="{x:Bind ViewModel.FirstRun.StepTitle, Mode=OneWay}" />

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FirstRun.RoleVis, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Daily PC is the common path. A dedicated second computer is uncommon and first-class." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.FirstRun.ChooseRoleCommand}" CommandParameter="daily" Content="Daily PC" Style="{StaticResource StudioButtonPrimary}" />
                            <Button Command="{x:Bind ViewModel.FirstRun.ChooseRoleCommand}" CommandParameter="dedicated" Content="Dedicated twin box" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.FirstRun.MachineRole, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FirstRun.DiskVis, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="50 GB is the serious floor. Custom on a dedicated box has no cap." />
                        <TextBox Header="Library / vault path" Text="{x:Bind ViewModel.FirstRun.LibraryPath, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.FirstRun.ChooseProfileCommand}" CommandParameter="full" Content="Full" Style="{StaticResource StudioButtonSecondary}" />
                            <Button Command="{x:Bind ViewModel.FirstRun.ChooseProfileCommand}" CommandParameter="studio" Content="Studio 50GB+" Style="{StaticResource StudioButtonPrimary}" />
                            <Button Command="{x:Bind ViewModel.FirstRun.ChooseProfileCommand}" CommandParameter="dedicated" Content="Dedicated" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FirstRun.PairVis, Mode=OneWay}">
                        <TextBox Header="Backend URL" Text="{x:Bind ViewModel.FirstRun.BackendUrl, Mode=TwoWay}" />
                        <TextBox Header="Session token" Text="{x:Bind ViewModel.FirstRun.SessionToken, Mode=TwoWay}" />
                        <TextBox Header="Device token" Text="{x:Bind ViewModel.FirstRun.DeviceToken, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.FirstRun.OpenSignInCommand}" Content="Open sign-in" Style="{StaticResource StudioButtonSecondary}" />
                            <Button Command="{x:Bind ViewModel.FirstRun.PairCommand}" Content="Pair this PC" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FirstRun.KeysVis, Mode=OneWay}">
                        <TextBox Header="Vendor email" PlaceholderText="Copied into vendor sign-up" Text="{x:Bind ViewModel.FirstRun.VendorEmail, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="After provision, a stay-on-top guide opens official pages. You click Create account, I'm not a robot, and Verify. Paste keys here — we never read them off a screenshot." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.FirstRun.BackCommand}" Content="Back" Style="{StaticResource StudioButtonQuiet}" />
                        <Button Command="{x:Bind ViewModel.FirstRun.NextCommand}" Content="Next" Style="{StaticResource StudioButtonSecondary}" />
                        <Button Click="FinishSetup" Content="Provision &amp; continue" Style="{StaticResource StudioButtonPrimary}" />
                        <Button Click="SkipSetup" Content="Skip for now" Style="{StaticResource StudioButtonQuiet}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.FirstRun.Progress, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="Coach"
            Grid.RowSpan="3"
            Width="380"
            Margin="0,0,16,48"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource HeirloomBgElevatedBrush}"
            BorderBrush="{StaticResource HeirloomGoldBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind ViewModel.Coach.Overline, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioWordmark}" FontSize="22" Text="{x:Bind ViewModel.Coach.Title, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Coach.Body, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Coach.Bullets, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBox
                    PlaceholderText="{x:Bind ViewModel.Coach.Placeholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Coach.DraftKey, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.Coach.PasteVis, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Coach.Hint, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.Coach.ContinueCommand}" Content="{x:Bind ViewModel.Coach.Cta, Mode=OneWay}" Style="{StaticResource StudioButtonPrimary}" />
                    <Button Command="{x:Bind ViewModel.Coach.SkipCommand}" Content="Skip" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Command="{x:Bind ViewModel.Coach.ReopenPageCommand}" Content="Reopen page" Style="{StaticResource StudioButtonSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            x:Name="Splash"
            Grid.RowSpan="3"
            Background="{StaticResource HeirloomBgBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource HeirloomSerif}"
                    FontSize="56"
                    Foreground="{StaticResource HeirloomTextBrush}"
                    Text="Heirloom" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="A CONTINUATION OF YOU" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
