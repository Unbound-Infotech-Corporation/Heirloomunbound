<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Heirloom.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Heirloom.Controls"
    xmlns:svc="using:Heirloom.Services"
    xmlns:vm="using:Heirloom.ViewModels"
    Background="{StaticResource HeirloomBgBaseBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ChatLineTemplate" x:DataType="vm:ChatLine">
            <Grid Margin="0,2,0,10">
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="{x:Bind Text}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind MetaVis}" />
                <Border
                    MaxWidth="520"
                    Padding="12,10"
                    HorizontalAlignment="Right"
                    Background="{StaticResource HeirloomYouBubbleBrush}"
                    BorderBrush="{StaticResource HeirloomGoldDeepBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{x:Bind YouVis}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource StudioRole}" Text="You" />
                        <TextBlock
                            Style="{StaticResource StudioText}"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    MaxWidth="520"
                    Padding="12,10"
                    HorizontalAlignment="Left"
                    Background="{StaticResource HeirloomTwinBubbleBrush}"
                    BorderBrush="{StaticResource HeirloomBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{x:Bind OtherVis}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{StaticResource HeirloomGoldBrush}"
                            Style="{StaticResource StudioRole}"
                            Text="{x:Bind RoleLabel}" />
                        <TextBlock
                            Style="{StaticResource StudioText}"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource StudioMuted}"
                            Text="{x:Bind Citation}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind CiteVis}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ArchiveRowTemplate" x:DataType="vm:ArchiveEntry">
            <Border Margin="0,0,0,8" Style="{StaticResource StudioCard}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Headline}" />
                    <TextBlock
                        Style="{StaticResource StudioText}"
                        Text="{x:Bind Body}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind Meta}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border
            Background="{StaticResource HeirloomChromeBrush}"
            BorderBrush="{StaticResource HeirloomBorderBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar Margin="8,0" VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="import" Text="Import…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Archive.CaptureCommand}" Text="Quick capture" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnQuit" Text="Quit Heirloom" />
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.TogglePaletteCommand}" Text="Command palette…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="settings" Text="Settings…" />
                </MenuBarItem>
                <MenuBarItem Title="Assist">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="assistant" Text="Work on this PC" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Assistant.NewConversationCommand}" Text="New job" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="mixer" Text="Mixer…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="today" Text="Today" />
                </MenuBarItem>
                <MenuBarItem Title="Twin">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="twin" Text="Sitting" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Twin.NewConversationCommand}" Text="New conversation" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="personality" Text="Portrait…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="abilities" Text="Abilities…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="skills" Text="Skills…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="phone" Text="Phone…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="avatar" Text="Avatar studio…" />
                </MenuBarItem>
                <MenuBarItem Title="Audio">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="mixer" Text="Mixer…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.ToggleMuteCommand}" Text="Mute Heirloom session" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.RefreshDevicesCommand}" Text="Rescan devices" />
                </MenuBarItem>
                <MenuBarItem Title="Models">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="models" Text="Local brain…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="keys" Text="Keys…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Models.RefreshCommand}" Text="Refresh probe" />
                </MenuBarItem>
                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CascadeWindowsCommand}" Text="Cascade" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.TileWindowsCommand}" Text="Tile" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CycleWindowsCommand}" Text="Cycle" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CloseAllCommand}" Text="Close all" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="assistant" Text="Assist" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="twin" Text="Twin sitting" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="today" Text="Today" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="archive" Text="Archive" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="journal" Text="Journal" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="interviewer" Text="Interviewer" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="photos" Text="Photos" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="library" Text="Library" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="skills" Text="Skills" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="phone" Text="Phone" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="heirs" Text="Heirs" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="letters" Text="Letters" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="glossary" Text="Glossary" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="kitchensink" Text="Control kit" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Click="OnToggleInspector" Text="Hover inspector" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="glossary" Text="Glossary…" />
                    <MenuFlyoutItem Click="OnExplainActive" Text="Explain this window" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="kitchensink" Text="Control kit" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ReopenFirstRunCommand}" Text="Getting started…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.StartCoachCommand}" Text="Optional: copied voice guide…" />
                    <MenuFlyoutItem Text="Heirloom is an Unbound Infotech product" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Grid x:Name="StudioBody" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopDockRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftDockCol" Width="188" MinWidth="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitCol" Width="6" />
                <ColumnDefinition x:Name="InspectorCol" Width="292" MinWidth="0" />
                <ColumnDefinition x:Name="RightDockCol" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <controls:DockRail
                x:Name="TopRail"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                DocumentRequested="OnDockDocument"
                Edge="top"
                EdgeDropped="OnDockEdgeDropped"
                ItemsSource="{x:Bind ViewModel.Dock}"
                ActiveId="{x:Bind ViewModel.ActiveDocumentId, Mode=OneWay}"
                SizeChangedByUser="OnDockSizeChanged"
                Visibility="Collapsed" />

            <controls:DockRail
                x:Name="LeftRail"
                Grid.Row="1"
                Grid.Column="0"
                DocumentRequested="OnDockDocument"
                Edge="left"
                EdgeDropped="OnDockEdgeDropped"
                ItemsSource="{x:Bind ViewModel.Dock}"
                ActiveId="{x:Bind ViewModel.ActiveDocumentId, Mode=OneWay}"
                SizeChangedByUser="OnDockSizeChanged" />

            <Canvas x:Name="Workspace" Grid.Row="1" Grid.Column="1">

                <controls:StudioDocumentWindow
                    x:Name="AssistDoc"
                    Width="960"
                    Height="620"
                    Canvas.Left="28"
                    Canvas.Top="18"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="assistant"
                    StatusText="{x:Bind ViewModel.Assistant.Status, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Assistant.PendingSummary, Mode=OneWay}"
                    TitleText="Assist">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <StackPanel Padding="6,4" Orientation="Horizontal" Spacing="1">
                            <controls:StudioActionButton
                                AssetId="action-new"
                                Command="{x:Bind ViewModel.Assistant.NewConversationCommand}"
                                Glyph="&#xE710;"
                                Label="New" />
                            <controls:StudioActionButton
                                AssetId="action-mixer"
                                Click="OnMenuOpen"
                                Glyph="&#xE767;"
                                Label="Mixer"
                                Tag="mixer" />
                            <controls:StudioActionButton
                                AssetId="action-archive"
                                Click="OnMenuOpen"
                                Glyph="&#xE8F1;"
                                Label="Vault"
                                Tag="archive" />
                            <controls:StudioActionButton
                                Command="{x:Bind ViewModel.Assistant.StopJobCommand}"
                                Glyph="&#xE71A;"
                                Kind="Quiet"
                                Label="Stop" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <controls:StudioDocumentWindow.OptionsContent>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StudioOverline}"
                                    Text="Speak" />
                                <ToggleSwitch
                                    MinWidth="40"
                                    AutomationProperties.Name="Speak replies"
                                    IsOn="{x:Bind ViewModel.Assistant.SpeakReplies, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    svc:StudioHint.Topic="speak" />
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource StudioCaption}"
                                Text="{x:Bind ViewModel.Assistant.Mixer.Status, Mode=OneWay}"
                                TextWrapping="NoWrap"
                                svc:StudioHint.Topic="session" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.OptionsContent>
                    <Grid ColumnSpacing="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="268" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{StaticResource HeirloomBgSurfaceBrush}"
                            BorderBrush="{StaticResource HeirloomBorderBrush}"
                            BorderThickness="0,0,1,0">
                            <Grid Padding="16,14" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Talk" />
                                <controls:PttButton
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    IsArmed="{x:Bind ViewModel.Assistant.IsRecording, Mode=OneWay}"
                                    Pressed="AssistPttPressed"
                                    Released="AssistPttReleased"
                                    svc:StudioHint.Topic="ptt" />
                                <StackPanel Grid.Row="2" Spacing="6">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Mic level" />
                                    <ProgressBar
                                        AutomationProperties.Name="Mic level"
                                        Maximum="1"
                                        Style="{StaticResource StudioMeter}"
                                        Value="{x:Bind ViewModel.Assistant.Level, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Hold to speak a job. Assist works on this PC — never as you." />
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Did" />
                                </StackPanel>
                                <ListView
                                    Grid.Row="3"
                                    ItemContainerStyle="{StaticResource StudioChatItem}"
                                    ItemsSource="{x:Bind ViewModel.Assistant.Work}"
                                    SelectionMode="None"
                                    Style="{StaticResource StudioPlainList}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Style="{StaticResource StudioMuted}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Padding="0" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView
                                x:Name="AssistChatList"
                                ItemTemplate="{StaticResource ChatLineTemplate}"
                                ItemsSource="{x:Bind ViewModel.Assistant.Lines}"
                                Style="{StaticResource StudioChatList}" />
                            <Border
                                Grid.Row="1"
                                Margin="16,0,16,8"
                                Style="{StaticResource StudioPending}"
                                Visibility="{x:Bind ViewModel.Assistant.PendingVis, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Confirm in this document" />
                                    <TextBlock
                                        Style="{StaticResource StudioText}"
                                        Text="{x:Bind ViewModel.Assistant.PendingSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Command="{x:Bind ViewModel.Assistant.ConfirmCommand}"
                                            Content="Confirm"
                                            Style="{StaticResource StudioButtonPrimary}" />
                                        <Button
                                            Command="{x:Bind ViewModel.Assistant.CancelPendingCommand}"
                                            Content="Do not run"
                                            Style="{StaticResource StudioButtonQuiet}" />
                                        <Button
                                            Command="{x:Bind ViewModel.Assistant.StopJobCommand}"
                                            Content="Stop"
                                            Style="{StaticResource StudioButtonQuiet}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="2"
                                Margin="16,0,16,16"
                                Style="{StaticResource StudioComposer}">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ProgressBar
                                        Height="2"
                                        IsIndeterminate="True"
                                        Style="{StaticResource StudioMeter}"
                                        Visibility="{x:Bind ViewModel.Assistant.BusyVis, Mode=OneWay}" />
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            PlaceholderText="Open notepad. Find the tax PDF. What’s on screen…"
                                            Style="{StaticResource StudioComposerField}"
                                            Text="{x:Bind ViewModel.Assistant.Draft, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            MinHeight="36"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.Assistant.SendCommand}"
                                            Content="Do"
                                            Style="{StaticResource StudioButtonPrimary}"
                                            svc:StudioHint.Topic="ask" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    x:Name="TwinDoc"
                    Width="920"
                    Height="600"
                    Canvas.Left="56"
                    Canvas.Top="46"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="twin"
                    StatusText="{x:Bind ViewModel.Twin.Status, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Twin.LastCitation, Mode=OneWay}"
                    TitleText="Twin">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <StackPanel Padding="6,4" Orientation="Horizontal" Spacing="1">
                            <controls:StudioActionButton
                                AssetId="action-new"
                                Command="{x:Bind ViewModel.Twin.NewConversationCommand}"
                                Glyph="&#xE710;"
                                Label="New" />
                            <controls:StudioActionButton
                                Command="{x:Bind ViewModel.Twin.StopJobCommand}"
                                Glyph="&#xE71A;"
                                Kind="Quiet"
                                Label="Stop" />
                            <controls:StudioActionButton
                                AssetId="action-archive"
                                Click="OnMenuOpen"
                                Glyph="&#xE8F1;"
                                Label="Archive"
                                Tag="archive" />
                            <controls:StudioActionButton
                                AssetId="action-undo"
                                Command="{x:Bind ViewModel.Twin.UndoLastFileCommand}"
                                Glyph="&#xE7A7;"
                                Kind="Quiet"
                                Label="Undo file" />
                            <controls:StudioActionButton
                                Command="{x:Bind ViewModel.Twin.FileSittingCommand}"
                                Glyph="&#xE8A5;"
                                IsEnabled="{x:Bind ViewModel.Twin.CanEdit, Mode=OneWay}"
                                Label="File this sitting" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <controls:StudioDocumentWindow.OptionsContent>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StudioOverline}"
                                    Text="Persona" />
                                <ComboBox
                                    Width="120"
                                    MinHeight="32"
                                    ItemsSource="{x:Bind ViewModel.Twin.Personas}"
                                    SelectedItem="{x:Bind ViewModel.Twin.Persona, Mode=TwoWay}"
                                    svc:StudioHint.Topic="persona" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StudioOverline}"
                                    Text="Grounded" />
                                <ToggleSwitch
                                    MinWidth="40"
                                    AutomationProperties.Name="Grounded only"
                                    IsEnabled="{x:Bind ViewModel.Twin.CanEdit, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.Twin.GroundedOnly, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    svc:StudioHint.Topic="grounded" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StudioOverline}"
                                    Text="Speak" />
                                <ToggleSwitch
                                    MinWidth="40"
                                    AutomationProperties.Name="Speak replies"
                                    IsOn="{x:Bind ViewModel.Twin.SpeakReplies, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    svc:StudioHint.Topic="speak" />
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource StudioCaption}"
                                Text="{x:Bind ViewModel.Twin.Mixer.Status, Mode=OneWay}"
                                TextWrapping="NoWrap"
                                svc:StudioHint.Topic="session" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.OptionsContent>
                    <Grid ColumnSpacing="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="268" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{StaticResource HeirloomBgSurfaceBrush}"
                            BorderBrush="{StaticResource HeirloomBorderBrush}"
                            BorderThickness="0,0,1,0">
                            <Grid Padding="16,14" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Talk" />
                                <controls:PttButton
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    IsArmed="{x:Bind ViewModel.Twin.IsRecording, Mode=OneWay}"
                                    Pressed="TwinPttPressed"
                                    Released="TwinPttReleased"
                                    svc:StudioHint.Topic="ptt" />
                                <StackPanel Grid.Row="2" Spacing="6">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Mic level" />
                                    <ProgressBar
                                        AutomationProperties.Name="Mic level"
                                        Maximum="1"
                                        Style="{StaticResource StudioMeter}"
                                        Value="{x:Bind ViewModel.Twin.Level, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Hold to ask aloud." />
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Likeness" />
                                </StackPanel>
                                <Border
                                    Grid.Row="3"
                                    Height="168"
                                    Background="{StaticResource HeirloomBgElevatedBrush}"
                                    BorderBrush="{StaticResource HeirloomBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <Grid>
                                        <MediaPlayerElement
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            Source="{x:Bind ViewModel.Avatar.GeneratedSource, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ViewModel.Avatar.HasGenerated, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource StudioEmpty}"
                                            Text="Made in Video studio."
                                            Visibility="{x:Bind ViewModel.Avatar.NeedsLikeness, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource StudioMuted}"
                                    TextWrapping="Wrap"
                                    Text="Filed likeness. Ask speaks in Mixer; this take does not lip-sync each answer." />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView
                                x:Name="TwinChatList"
                                ItemTemplate="{StaticResource ChatLineTemplate}"
                                ItemsSource="{x:Bind ViewModel.Twin.Lines}"
                                Style="{StaticResource StudioChatList}" />
                            <Border
                                Grid.Row="1"
                                Margin="16,0,16,16"
                                Style="{StaticResource StudioComposer}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ProgressBar
                                        Height="2"
                                        IsIndeterminate="True"
                                        Style="{StaticResource StudioMeter}"
                                        Visibility="{x:Bind ViewModel.Twin.BusyVis, Mode=OneWay}" />
                                    <Border
                                        Grid.Row="1"
                                        Margin="8,8,8,0"
                                        Style="{StaticResource StudioPending}"
                                        Visibility="{x:Bind ViewModel.Twin.PendingVis, Mode=OneWay}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource StudioOverline}" Text="Confirm in this document" />
                                            <TextBlock
                                                Style="{StaticResource StudioText}"
                                                Text="{x:Bind ViewModel.Twin.PendingSummary, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Command="{x:Bind ViewModel.Twin.ConfirmCommand}"
                                                    Content="Confirm"
                                                    Style="{StaticResource StudioButtonPrimary}" />
                                                <Button
                                                    Command="{x:Bind ViewModel.Twin.CancelPendingCommand}"
                                                    Content="Do not run"
                                                    Style="{StaticResource StudioButtonQuiet}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button
                                        Grid.Row="2"
                                        Margin="8,8,8,0"
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.Twin.MakeVideoOfLastCommand}"
                                        Content="Make a video of that"
                                        Style="{StaticResource StudioButtonSecondary}"
                                        Visibility="{x:Bind ViewModel.Twin.OfferVideoVis, Mode=OneWay}"
                                        svc:StudioHint.Topic="make-film" />
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            PlaceholderText="Ask only what they left…"
                                            Style="{StaticResource StudioComposerField}"
                                            Text="{x:Bind ViewModel.Twin.Draft, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            MinHeight="36"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.Twin.StopJobCommand}"
                                            Content="Stop"
                                            Style="{StaticResource StudioButtonQuiet}" />
                                        <Button
                                            Grid.Column="2"
                                            MinHeight="36"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.Twin.SendCommand}"
                                            Content="Ask"
                                            Style="{StaticResource StudioButtonPrimary}"
                                            svc:StudioHint.Topic="ask" />
                                    </Grid>
                                </Grid>
