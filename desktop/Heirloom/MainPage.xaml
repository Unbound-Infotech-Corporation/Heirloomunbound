                        <TextBox Header="Device token" Text="{x:Bind ViewModel.FirstRun.DeviceToken, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.FirstRun.OpenSignInCommand}" Content="Open sign-in" Style="{StaticResource StudioButtonSecondary}" />
