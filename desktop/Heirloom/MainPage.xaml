                                                Width="120"
                                                BorderBrush="{StaticResource HeirloomBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <StackPanel>
                                                    <Grid Height="140">
                                                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Margin="4"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Command="{x:Bind RemoveCommand}"
                                                            CommandParameter="{x:Bind}"
                                                            Style="{StaticResource StudioButtonQuiet}"
                                                            ToolTipService.ToolTip="Remove">
                                                            <FontIcon
                                                                FontSize="10"
                                                                Foreground="{StaticResource HeirloomTextSecondaryBrush}"
                                                                Glyph="&#xE711;" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock
                                                        Margin="8,6"
                                                        Style="{StaticResource StudioCaption}"
                                                        Text="{x:Bind Fit}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Line to speak" />
                                    <TextBox
                                        PlaceholderText="A sentence in your voice"
                                        Text="{x:Bind ViewModel.Avatar.LineToSpeak, Mode=TwoWay}" />
                                </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Avatar.FilmVis, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Preset" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="Title"
                                        ItemsSource="{x:Bind ViewModel.Avatar.Presets}"
                                        SelectedItem="{x:Bind ViewModel.Avatar.SelectedPreset, Mode=TwoWay}" />
                                    <TextBlock
                                        Style="{StaticResource StudioMuted}"
                                        Text="{x:Bind ViewModel.Avatar.SelectedPreset.Blurb, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="What you say" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        MinHeight="72"
                                        PlaceholderText="The line in your cloned voice"
                                        Text="{x:Bind ViewModel.Avatar.LineToSpeak, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.Avatar.ShotCountLine, Mode=OneWay}" />
                                    <ListView
                                        IsItemClickEnabled="False"
                                        ItemsSource="{x:Bind ViewModel.Avatar.Shots, Mode=OneWay}"
                                        SelectionMode="None"
                                        Style="{StaticResource StudioPlainList}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoShotRow">
                                                <StackPanel Padding="0,8" Spacing="2">
                                                    <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind BeatLine}" />
                                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ScriptLine}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind PhotoLine}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind ModelLine}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Style="{StaticResource StudioMuted}"
                                        TextWrapping="Wrap"
                                        Text="Make film speaks with the Twin’s voice on the filed face, then holds photographs. Wan or LTX motion is used only when those weights are already on this PC — this room never opens a ComfyUI graph." />
                                </StackPanel>
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Avatar.EnginesVis, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="What this PC can run" />
                                    <TextBlock
                                        Style="{StaticResource StudioMuted}"
                                        Text="{x:Bind ViewModel.Avatar.RecommendLine, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <ListView
                                        IsItemClickEnabled="False"
                                        ItemsSource="{x:Bind ViewModel.Avatar.Models}"
                                        SelectionMode="None"
                                        Style="{StaticResource StudioPlainList}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="svc:VideoModelChoice">
                                                <StackPanel Padding="0,10" Spacing="2">
                                                    <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind Title}" />
                                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind RecommendFor}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind Blurb}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Vram}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            Grid.Column="1"
                            Background="{StaticResource HeirloomBgSurfaceBrush}"
                            BorderBrush="{StaticResource HeirloomBorderBrush}"
                            BorderThickness="1,0,0,0">
                            <ScrollViewer Padding="14,14">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Film" />
                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Avatar.FilmLine, Mode=OneWay}" TextWrapping="Wrap" />
                                    <Border
                                        Height="180"
                                        Background="{StaticResource HeirloomBgElevatedBrush}"
                                        BorderBrush="{StaticResource HeirloomBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <MediaPlayerElement
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="False"
                                            Source="{x:Bind ViewModel.Avatar.FilmSource, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ViewModel.Avatar.HasFilm, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Live version" />
                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Avatar.GeneratedLine, Mode=OneWay}" TextWrapping="Wrap" />
                                    <Border
                                        Height="180"
                                        Background="{StaticResource HeirloomBgElevatedBrush}"
                                        BorderBrush="{StaticResource HeirloomBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <MediaPlayerElement
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="True"
                                            Source="{x:Bind ViewModel.Avatar.GeneratedSource, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ViewModel.Avatar.HasGenerated, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Sitting" />
                                    <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Avatar.SittingLine, Mode=OneWay}" />
                                    <Border
                                        Height="120"
                                        Background="{StaticResource HeirloomBgElevatedBrush}"
                                        BorderBrush="{StaticResource HeirloomBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <MediaPlayerElement
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="False"
                                            Source="{x:Bind ViewModel.Avatar.SittingSource, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ViewModel.Avatar.HasSitting, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource StudioOverline}" Text="Engine" />
                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Avatar.EngineLine, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Avatar.RecommendLine, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="520"
                    Height="340"
                    Canvas.Left="200"
                    Canvas.Top="80"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="keys"
                    StatusText="{x:Bind ViewModel.Keys.Hint, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Keys.Hint, Mode=OneWay}"
                    TitleText="Keys"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <StackPanel Padding="6,4" Orientation="Horizontal" Spacing="1">
                            <controls:StudioActionButton
                                Command="{x:Bind ViewModel.Keys.TestCommand}"
                                Glyph="&#xE8F1;"
                                Kind="Primary"
                                Label="Test reach"
                                svc:StudioHint.Topic="keys" />
                            <controls:StudioActionButton
                                Click="OnMenuOpen"
                                Glyph="&#xE713;"
                                Label="Settings"
                                Tag="settings" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <StackPanel Padding="16" Spacing="10">
                        <TextBlock Style="{StaticResource StudioOverline}" Text="Session" />
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Keys.SessionLine, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioOverline}" Text="Device" />
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Keys.DeviceLine, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Paste the session and device tokens in Settings, then Test reach. Heirloom never reads keys off a screenshot." />
                    </StackPanel>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="560"
                    Height="360"
                    Canvas.Left="72"
                    Canvas.Top="64"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="thismachine"
                    StatusText="{x:Bind ViewModel.Models.OllamaStatus, Mode=OneWay}"
                    TitleText="This PC"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <StackPanel Padding="6,4" Orientation="Horizontal" Spacing="1">
                            <controls:StudioActionButton
                                Command="{x:Bind ViewModel.Models.RefreshCommand}"
                                Glyph="&#xE72C;"
                                Kind="Primary"
                                Label="Probe" />
                            <controls:StudioActionButton
                                Click="OnMenuOpen"
                                Glyph="&#xE950;"
                                Label="Models"
                                Tag="models" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <StackPanel Padding="16" Spacing="10">
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Daily PC or dedicated twin box. Probe talks to Ollama and the vault on this machine." />
                        <TextBlock Style="{StaticResource StudioOverline}" Text="Role" />
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Models.MachineRole, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioOverline}" Text="Compute" />
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Models.ComputeTarget, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.DiskLine, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.WhisperStatus, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.OllamaStatus, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.Models.SetRoleCommand}" CommandParameter="daily" Content="Daily PC" Style="{StaticResource StudioButtonSecondary}" />
                            <Button Command="{x:Bind ViewModel.Models.SetRoleCommand}" CommandParameter="dedicated" Content="Dedicated box" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.Models.SetComputeCommand}" CommandParameter="local" Content="This PC" Style="{StaticResource StudioButtonSecondary}" />
                            <Button Command="{x:Bind ViewModel.Models.SetComputeCommand}" CommandParameter="network" Content="Network" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="640"
                    Canvas.Left="96"
                    Canvas.Top="24"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="settings"
                    SubtitleText="{x:Bind ViewModel.Settings.VersionLine, Mode=OneWay}"
                    TitleText="Settings"
                    Visibility="Collapsed">
                    <ScrollViewer Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="Look and reach" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Settings.ChromeHint, Mode=OneWay}" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Color" />
                                <ComboBox
                                    Width="320"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind ViewModel.Settings.Schemes}"
                                    SelectedItem="{x:Bind ViewModel.Settings.SelectedScheme, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Buttons" />
                                <ComboBox
                                    Width="320"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind ViewModel.Settings.ChromeModes}"
                                    SelectedItem="{x:Bind ViewModel.Settings.SelectedChrome, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Dock edge" />
                                <ComboBox
                                    Width="320"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{x:Bind ViewModel.Settings.DockEdges}"
                                    SelectedItem="{x:Bind ViewModel.Settings.SelectedDockEdge, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Dock width" />
                                <Slider
                                    Width="320"
                                    Maximum="280"
                                    Minimum="56"
                                    StepFrequency="4"
                                    Value="{x:Bind ViewModel.Settings.DockSize, Mode=TwoWay}" />
                            </StackPanel>
                            <Grid MinHeight="32" Width="320">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="Lock dock" />
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.Settings.DockLocked, Mode=TwoWay}" />
                            </Grid>
                            <Grid MinHeight="32" Width="320">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="Hover inspector" />
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.Settings.InspectorOpen, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Inspector width" />
                                <Slider
                                    Width="320"
                                    Maximum="480"
                                    Minimum="220"
                                    StepFrequency="4"
                                    Value="{x:Bind ViewModel.Settings.InspectorWidth, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Point at a button or dock tile. The right panel names it. F1 shows or hides the panel. ? on a window pins that room." />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Drag the Dock bar to snap left, right, or top. Drag the seam to widen until names fit. Item order never changes." />
                            <TextBlock Style="{StaticResource StudioOverline}" Text="Your buttons" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Settings.ChromeFolder, Mode=OneWay}" />
                            <controls:StudioActionButton
                                AssetId="action-folder"
                                Command="{x:Bind ViewModel.Settings.OpenChromeFolderCommand}"
                                Glyph="&#xE8B7;"
                                Label="Open buttons folder" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Drop square PNGs named dock-twin.png, action-file.png, and so on. Simple silhouettes search faster than photos." />
                            <TextBlock Style="{StaticResource StudioOverline}" Text="Account" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Backend URL" />
                                <TextBox Text="{x:Bind ViewModel.Settings.BackendUrl, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StudioOverline}" Text="Vault folder" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="The archive lives in a folder on this PC. Change it to another drive or directory. Heirloom opens vault.db there and creates one if the folder is new. The previous folder is not moved or deleted." />
                            <TextBox Text="{x:Bind ViewModel.Settings.LibraryPath, Mode=TwoWay}" />
                            <controls:StudioActionButton
                                AssetId="action-folder"
                                Command="{x:Bind ViewModel.Settings.BrowseVaultCommand}"
                                Glyph="&#xE8B7;"
                                Label="Browse vault folder"
                                svc:StudioHint.Topic="library" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Session token" />
                                <TextBox PlaceholderText="Paste after browser sign-in" Text="{x:Bind ViewModel.Settings.SessionToken, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Device token" />
                                <TextBox PlaceholderText="Paired device token" Text="{x:Bind ViewModel.Settings.DeviceToken, Mode=TwoWay}" />
                            </StackPanel>
                            <Grid MinHeight="32" Width="320">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="Autostart" />
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.Settings.Autostart, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:StudioActionButton
                                    AssetId="action-save"
                                    Command="{x:Bind ViewModel.Settings.SaveCommand}"
                                    Glyph="&#xE74E;"
                                    Kind="Primary"
                                    Label="Save settings" />
                                <controls:StudioActionButton
                                    AssetId="action-signout"
                                    Command="{x:Bind ViewModel.Settings.SignOutCommand}"
                                    Glyph="&#xF3B1;"
                                    Kind="Danger"
                                    Label="Sign out" />
                                <controls:StudioActionButton
                                    AssetId="action-setup"
                                    Command="{x:Bind ViewModel.ReopenFirstRunCommand}"
                                    Glyph="&#xE90F;"
                                    Label="Getting started" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="560"
                    Canvas.Left="64"
                    Canvas.Top="36"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="glossary"
                    SubtitleText="{x:Bind ViewModel.Glossary.Status, Mode=OneWay}"
                    TitleText="Glossary"
                    Visibility="Collapsed">
                    <Grid Padding="16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Search" />
                                <TextBox PlaceholderText="twin, vault, WASAPI…" Text="{x:Bind ViewModel.Glossary.Query, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Style="{StaticResource StudioOverline}" Text="Show" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.Glossary.Kinds}"
                                    SelectedItem="{x:Bind ViewModel.Glossary.Kind, Mode=TwoWay}" />
                            </StackPanel>
                            <ListView
                                Grid.Row="2"
                                ItemContainerStyle="{StaticResource StudioChatItem}"
                                ItemsSource="{x:Bind ViewModel.Glossary.Results}"
                                SelectedItem="{x:Bind ViewModel.Glossary.Selected, Mode=TwoWay}"
                                Style="{StaticResource StudioPlainList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:HelpTopic">
                                        <StackPanel Margin="0,6">
                                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Kind}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <ScrollViewer Grid.Column="1" Padding="8,0">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource StudioWordmark}" Text="{x:Bind ViewModel.Glossary.SelectedTitle, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource StudioText}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Glossary.SelectedSummary, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Glossary.SelectedBody, Mode=OneWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="480"
                    Canvas.Left="48"
                    Canvas.Top="48"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="kitchensink"
                    TitleText="Control kit"
                    Visibility="Collapsed">
                    <ScrollViewer Padding="16">
                        <StackPanel MaxWidth="640" Spacing="16">
                            <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="Control kit" />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.KitchenSink.Hero}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Primary" Style="{StaticResource StudioButtonPrimary}" />
                                <Button Content="Secondary" Style="{StaticResource StudioButtonSecondary}" />
                                <Button Content="Quiet" Style="{StaticResource StudioButtonQuiet}" />
                                <Button Content="Destructive" Style="{StaticResource StudioButtonDanger}" />
                                <Button Content="Disabled" IsEnabled="False" Style="{StaticResource StudioButtonPrimary}" />
                            </StackPanel>
                            <controls:PttButton HorizontalAlignment="Left" />
                            <ProgressBar Width="280" Maximum="1" Style="{StaticResource StudioMeter}" Value="0.42" />
                            <Slider Width="280" Style="{StaticResource StudioSlider}" Value="72" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:StudioDocumentWindow>
            </Canvas>

            <Border
                x:Name="InspectorSplit"
                Grid.Row="1"
                Grid.Column="2"
                Width="6"
                Background="Transparent"
                PointerMoved="OnInspectorSplitMoved"
                PointerPressed="OnInspectorSplitPressed"
                PointerReleased="OnInspectorSplitReleased">
                <Border Width="1" HorizontalAlignment="Center" Background="{StaticResource HeirloomBorderBrush}" />
            </Border>

            <controls:HelpInspector
                x:Name="Inspector"
                Grid.Row="1"
                Grid.Column="3"
                GlossaryRequested="OnInspectorGlossary"
                HideRequested="OnInspectorHide"
                TopicRequested="OnInspectorTopic" />

            <controls:DockRail
                x:Name="RightRail"
                Grid.Row="1"
                Grid.Column="4"
                DocumentRequested="OnDockDocument"
                Edge="right"
                EdgeDropped="OnDockEdgeDropped"
                ItemsSource="{x:Bind ViewModel.Dock}"
                ActiveId="{x:Bind ViewModel.ActiveDocumentId, Mode=OneWay}"
                SizeChangedByUser="OnDockSizeChanged"
                Visibility="Collapsed" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{StaticResource HeirloomStatusBrush}"
            BorderBrush="{StaticResource HeirloomBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                <TextBlock
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="{x:Bind ViewModel.WindowLine, Mode=OneWay}" />
            </Grid>
        </Border>

        <Grid
            x:Name="Palette"
            Grid.RowSpan="3"
            Background="{StaticResource HeirloomScrimBrush}"
            Visibility="Collapsed">
            <Border
                Width="560"
                Margin="0,80,0,0"
                Padding="16"
                VerticalAlignment="Top"
                Background="{StaticResource HeirloomBgElevatedBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource StudioOverline}" Text="Command palette" />
                    <TextBox PlaceholderText="speak …  ·  capture …  ·  mixer  ·  interview" Text="{x:Bind ViewModel.CommandQuery, Mode=TwoWay}" />
                    <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.RunPaletteCommand}" Content="Run" Style="{StaticResource StudioButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="FirstRun"
            Grid.RowSpan="3"
            Background="{StaticResource HeirloomScrimBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="520"
                MaxHeight="720"
                Margin="24"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource HeirloomBgSurfaceBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource StudioOverline}" Text="Getting started" />
                        <TextBlock
                            FontSize="28"
                            Style="{StaticResource StudioWordmark}"
                            Text="{x:Bind ViewModel.FirstRun.Title, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource StudioMuted}"
                            Text="{x:Bind ViewModel.FirstRun.Body, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.FirstRun.WelcomeVis, Mode=OneWay}">
                            <Button
                                MinHeight="52"
                                Padding="20,14"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Get everything ready"
                                Command="{x:Bind ViewModel.FirstRun.GetReadyCommand}"
                                Content="Get everything ready"
                                FontSize="16"
                                Style="{StaticResource StudioButtonPrimary}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.FirstRun.SkipCommand}"
                                Content="I'll look around first"
                                Style="{StaticResource StudioButtonQuiet}" />
                        </StackPanel>

                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FirstRun.WorkingVis, Mode=OneWay}">
                            <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.Summary, Mode=OneWay}" />
                            <Border Padding="12,10" Background="{StaticResource HeirloomBgElevatedBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="Stories folder" />
                                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.FirstRun.VaultDetail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.VaultState, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Padding="12,10" Background="{StaticResource HeirloomBgElevatedBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="Hearing you speak" />
                                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.FirstRun.HearingDetail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.HearingState, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Padding="12,10" Background="{StaticResource HeirloomBgElevatedBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="A mind that can talk as you" />
                                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.FirstRun.MindDetail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.MindState, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Padding="12,10" Background="{StaticResource HeirloomBgElevatedBrush}" BorderBrush="{StaticResource HeirloomBorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="A talking picture" />
                                        <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.FirstRun.PictureDetail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.PictureState, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <TextBlock
                                Style="{StaticResource StudioMuted}"
                                Text="{x:Bind ViewModel.FirstRun.Fault, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.FirstRun.FaultVis, Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.FirstRun.RetryCommand}"
                                Content="Try again"
                                Style="{StaticResource StudioButtonPrimary}"
                                Visibility="{x:Bind ViewModel.FirstRun.RetryVis, Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.FirstRun.StopCommand}"
                                Content="Stop"
                                Style="{StaticResource StudioButtonQuiet}"
                                Visibility="{x:Bind ViewModel.FirstRun.StopVis, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.FirstRun.DoneVis, Mode=OneWay}">
                            <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.FirstRun.Summary, Mode=OneWay}" />
                            <Button
                                MinHeight="52"
                                Padding="20,14"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Talk to your Twin"
                                Command="{x:Bind ViewModel.FirstRun.TalkCommand}"
                                Content="Talk to your Twin"
                                FontSize="16"
                                Style="{StaticResource StudioButtonPrimary}" />
                            <Button
                                MinHeight="44"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.FirstRun.RecordMemoryCommand}"
                                Content="Record a memory"
                                Style="{StaticResource StudioButtonSecondary}" />
                            <Button
                                MinHeight="44"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.FirstRun.MakeLikenessCommand}"
                                Content="Make a likeness"
                                Style="{StaticResource StudioButtonSecondary}" />
                            <Button
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.FirstRun.RetryCommand}"
                                Content="Try again"
                                Style="{StaticResource StudioButtonQuiet}"
                                Visibility="{x:Bind ViewModel.FirstRun.RetryVis, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border
            x:Name="Coach"
            Grid.RowSpan="3"
            Width="380"
            Margin="0,0,16,48"
                Padding="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource HeirloomBgElevatedBrush}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource StudioOverline}" Text="{x:Bind ViewModel.Coach.Overline, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioDocumentTitle}" Text="{x:Bind ViewModel.Coach.Title, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Coach.Body, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Coach.Bullets, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBox
                    PlaceholderText="{x:Bind ViewModel.Coach.Placeholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Coach.DraftKey, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.Coach.PasteVis, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Coach.Hint, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.Coach.ContinueCommand}" Content="{x:Bind ViewModel.Coach.Cta, Mode=OneWay}" Style="{StaticResource StudioButtonPrimary}" />
                    <Button Command="{x:Bind ViewModel.Coach.SkipCommand}" Content="Skip" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Command="{x:Bind ViewModel.Coach.ReopenPageCommand}" Content="Reopen page" Style="{StaticResource StudioButtonSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            x:Name="Splash"
            Grid.RowSpan="3"
            Background="{StaticResource HeirloomBgBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource StudioWordmark}"
                    FontSize="40"
                    Text="Heirloom" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource StudioOverline}"
                    Text="A continuation of you" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
