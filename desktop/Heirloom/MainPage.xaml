                    <Button Command="{x:Bind ViewModel.Coach.SkipCommand}" Content="Skip" Style="{StaticResource StudioButtonQuiet}" />
                    <Button Command="{x:Bind ViewModel.Coach.ReopenPageCommand}" Content="Reopen page" Style="{StaticResource StudioButtonSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            x:Name="Splash"
            Grid.RowSpan="3"
            Background="{StaticResource HeirloomBgBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource HeirloomSerif}"
                    FontSize="56"
                    Foreground="{StaticResource HeirloomTextBrush}"
                    Text="Heirloom" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource StudioCaption}"
                    Text="A CONTINUATION OF YOU" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
