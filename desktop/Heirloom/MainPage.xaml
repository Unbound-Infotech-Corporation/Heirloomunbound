<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Heirloom.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Heirloom.Controls"
    xmlns:vm="using:Heirloom.ViewModels"
    Background="{StaticResource HeirloomBgBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border
            Background="#991C1A18"
            BorderBrush="{StaticResource HeirloomBorderBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar Margin="8,0" VerticalAlignment="Center">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="import" Text="Import…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Archive.CaptureCommand}" Text="Quick capture" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnQuit" Text="Quit Heirloom" />
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.TogglePaletteCommand}" Text="Command palette…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="settings" Text="Settings…" />
                </MenuBarItem>
                <MenuBarItem Title="Twin">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="twin" Text="Conversation" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Twin.NewConversationCommand}" Text="New conversation" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="personality" Text="Portrait…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="abilities" Text="Abilities…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="avatar" Text="Avatar studio…" />
                </MenuBarItem>
                <MenuBarItem Title="Audio">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="mixer" Text="Mixer…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.ToggleMuteCommand}" Text="Mute Heirloom session" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.RefreshDevicesCommand}" Text="Rescan devices" />
                </MenuBarItem>
                <MenuBarItem Title="Models">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="models" Text="Local brain…" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="keys" Text="Keys…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.Models.RefreshCommand}" Text="Refresh probe" />
                </MenuBarItem>
                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CascadeWindowsCommand}" Text="Cascade" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.TileWindowsCommand}" Text="Tile" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CycleWindowsCommand}" Text="Cycle" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.CloseAllCommand}" Text="Close all" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="today" Text="Today" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="archive" Text="Archive" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="journal" Text="Journal" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="interviewer" Text="Interviewer" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="photos" Text="Photos" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="library" Text="Library" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="skills" Text="Skills" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="heirs" Text="Heirs" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="letters" Text="Letters" />
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="kitchensink" Text="Control kit" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Click="OnMenuOpen" Tag="kitchensink" Text="Control kit" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ReopenFirstRunCommand}" Text="First-run setup…" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.StartCoachCommand}" Text="Vendor key guide…" />
                    <MenuFlyoutItem Text="Heirloom is an Unbound Infotech product" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="#E11C1A18"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="0,0,1,0">
                <ListView
                    Padding="6,10"
                    IsItemClickEnabled="True"
                    ItemClick="Dock_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Dock}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DockItem">
                            <Grid Height="44" ToolTipService.ToolTip="{x:Bind Label}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{StaticResource HeirloomGoldBrush}"
                                    Glyph="{x:Bind Glyph}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

            <Canvas x:Name="Workspace" Grid.Column="1">

                <controls:StudioDocumentWindow
                    x:Name="TwinDoc"
                    Width="920"
                    Height="600"
                    Canvas.Left="28"
                    Canvas.Top="18"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="twin"
                    StatusText="{x:Bind ViewModel.Twin.Status, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Twin.LastCitation, Mode=OneWay}"
                    TitleText="Twin">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Twin">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Twin.NewConversationCommand}" Text="New conversation" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="avatar" Text="Avatar studio…" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="personality" Text="Portrait…" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="abilities" Text="Abilities…" />
                            </MenuBarItem>
                            <MenuBarItem Title="Voice">
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="mixer" Text="Mixer…" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="journal" Text="Voice journal…" />
                            </MenuBarItem>
                            <MenuBarItem Title="Memory">
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="archive" Text="Open archive" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="interviewer" Text="Interview chapters…" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <controls:StudioDocumentWindow.OptionsContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox
                                Width="140"
                                Header="Persona"
                                ItemsSource="{x:Bind ViewModel.Twin.Personas}"
                                SelectedItem="{x:Bind ViewModel.Twin.Persona, Mode=TwoWay}" />
                            <ToggleSwitch Header="Grounded only" IsOn="{x:Bind ViewModel.Twin.GroundedOnly, Mode=TwoWay}" OffContent="May infer" OnContent="Vault only" />
                            <ToggleSwitch Header="Speak replies" IsOn="{x:Bind ViewModel.Twin.SpeakReplies, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.OptionsContent>
                    <Grid ColumnSpacing="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{StaticResource HeirloomBgSurfaceBrush}"
                            BorderBrush="{StaticResource HeirloomBorderBrush}"
                            BorderThickness="0,0,1,0">
                            <StackPanel Padding="20" Spacing="16">
                                <TextBlock Style="{StaticResource StudioCaption}" Text="PRESENCE" />
                                <controls:PttButton
                                    HorizontalAlignment="Center"
                                    IsArmed="{x:Bind ViewModel.Twin.IsRecording, Mode=OneWay}"
                                    Pressed="PttPressed"
                                    Released="PttReleased" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource StudioMuted}"
                                    Text="{x:Bind ViewModel.Twin.AvatarState, Mode=OneWay}" />
                                <ProgressBar
                                    Foreground="{StaticResource HeirloomGoldBrush}"
                                    Maximum="1"
                                    Value="{x:Bind ViewModel.Twin.Level, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="If it isn’t in the vault, the twin says it doesn’t remember. That is the product." />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" Padding="16" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind ViewModel.Twin.Lines}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatLine">
                                        <TextBlock
                                            Margin="0,6"
                                            Style="{StaticResource StudioText}"
                                            Text="{x:Bind Display}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Ask only what they left…" Text="{x:Bind ViewModel.Twin.Draft, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.Twin.SendCommand}"
                                    Content="Send"
                                    Style="{StaticResource StudioButtonPrimary}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="760"
                    Height="540"
                    Canvas.Left="220"
                    Canvas.Top="72"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="mixer"
                    StatusText="{x:Bind ViewModel.Mixer.Status, Mode=OneWay}"
                    SubtitleText="Heirloom session — never the system master"
                    TitleText="Mixer">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Devices">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.RefreshDevicesCommand}" Text="Rescan" />
                            </MenuBarItem>
                            <MenuBarItem Title="Output">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Mixer.ToggleMuteCommand}" Text="Mute session" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <Grid ColumnSpacing="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Padding="20"
                            Background="{StaticResource HeirloomBgSurfaceBrush}"
                            Spacing="12">
                            <TextBlock Style="{StaticResource StudioCaption}" Text="HEIRLOOM SESSION" />
                            <ComboBox
                                Width="260"
                                Header="Microphone"
                                ItemsSource="{x:Bind ViewModel.Mixer.Inputs}"
                                SelectedItem="{x:Bind ViewModel.Mixer.SelectedInput, Mode=TwoWay}" />
                            <ComboBox
                                Width="260"
                                Header="Output"
                                ItemsSource="{x:Bind ViewModel.Mixer.Outputs}"
                                SelectedItem="{x:Bind ViewModel.Mixer.SelectedOutput, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="Session volume" />
                            <Slider Maximum="100" Value="{x:Bind ViewModel.Mixer.SessionVolume, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="Input gain" />
                            <Slider Maximum="4" Minimum="0.2" StepFrequency="0.05" Value="{x:Bind ViewModel.Mixer.InputGain, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="Noise gate" />
                            <Slider Maximum="0.4" StepFrequency="0.01" Value="{x:Bind ViewModel.Mixer.NoiseGate, Mode=TwoWay}" />
                            <ToggleSwitch Header="High-pass" IsOn="{x:Bind ViewModel.Mixer.HighPass, Mode=TwoWay}" />
                            <ToggleSwitch Header="Live listen" IsOn="{x:Bind ViewModel.Mixer.LiveListen, Mode=TwoWay}" />
                            <ToggleSwitch Header="Mute" IsOn="{x:Bind ViewModel.Mixer.Muted, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Padding="28" Spacing="10">
                            <TextBlock Style="{StaticResource StudioWordmark}" Text="This slider is Heirloom." />
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="Windows Volume Mixer shows a dedicated Heirloom session. Twin set_volume writes here — never the system master." />
                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Mixer.InputSummary, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Mixer.OutputSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="480"
                    Canvas.Left="64"
                    Canvas.Top="40"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="models"
                    StatusText="{x:Bind ViewModel.Models.DiskLine, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Models.Progress, Mode=OneWay}"
                    TitleText="Models"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Provision">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="lite" Text="Lite" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="full" Text="Full local" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="studio" Text="Studio 50GB+" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="dedicated" Text="Dedicated / custom" />
                            </MenuBarItem>
                            <MenuBarItem Title="Compute">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.SetComputeCommand}" CommandParameter="local" Text="This PC" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.SetComputeCommand}" CommandParameter="network" Text="Network companion" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Models.SetComputeCommand}" CommandParameter="server" Text="Remote Ollama" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <ScrollViewer Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.WhisperStatus, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.OllamaStatus, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Models.VaultStatus, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Models.MachineRole, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Models.ComputeTarget, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="full" Content="Full" Style="{StaticResource StudioButtonSecondary}" />
                                <Button Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="studio" Content="Studio 50GB+" Style="{StaticResource StudioButtonPrimary}" />
                                <Button Command="{x:Bind ViewModel.Models.ProvisionCommand}" CommandParameter="dedicated" Content="Dedicated" Style="{StaticResource StudioButtonSecondary}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="50 GB is the serious floor. A dedicated second PC is uncommon and first-class." />
                        </StackPanel>
                    </ScrollViewer>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="640"
                    Height="420"
                    Canvas.Left="80"
                    Canvas.Top="36"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="today"
                    StatusText="{x:Bind ViewModel.Today.Completeness, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Today.Streak, Mode=OneWay}"
                    TitleText="Today"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Today">
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="twin" Text="Open twin" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="interviewer" Text="Continue interview" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="journal" Text="Voice journal" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <StackPanel Padding="32" Spacing="12">
                        <TextBlock Style="{StaticResource StudioWordmark}" Text="{x:Bind ViewModel.Today.Greeting, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Today.Nudge, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind ViewModel.Today.NextChapter, Mode=OneWay}" />
                        <Button Click="OnMenuOpen" Content="Sit with the twin" Style="{StaticResource StudioButtonPrimary}" Tag="twin" />
                    </StackPanel>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="820"
                    Height="560"
                    Canvas.Left="48"
                    Canvas.Top="28"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="archive"
                    StatusText="{x:Bind ViewModel.Archive.Status, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Archive.Completeness, Mode=OneWay}"
                    TitleText="Archive"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Archive">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Archive.ReloadCommand}" Text="Refresh" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="import" Text="Import…" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="sources" Text="Sources…" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <controls:StudioDocumentWindow.OptionsContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                Width="140"
                                Header="Kind"
                                ItemsSource="{x:Bind ViewModel.Archive.Kinds}"
                                SelectedItem="{x:Bind ViewModel.Archive.KindFilter, Mode=TwoWay}" />
                            <ComboBox
                                Width="140"
                                Header="File as"
                                ItemsSource="{x:Bind ViewModel.Archive.Kinds}"
                                SelectedItem="{x:Bind ViewModel.Archive.CaptureKind, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:StudioDocumentWindow.OptionsContent>
                    <Grid Padding="16" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="One true sentence" Text="{x:Bind ViewModel.Archive.Draft, Mode=TwoWay}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.Archive.CaptureCommand}" Content="File" IsEnabled="{x:Bind ViewModel.Heirs.CanEdit, Mode=OneWay}" Style="{StaticResource StudioButtonPrimary}" />
                            <TextBox Grid.Column="2" PlaceholderText="Search or ask" Text="{x:Bind ViewModel.Archive.Query, Mode=TwoWay}" />
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.Archive.AskArchiveCommand}" Content="Ask" Style="{StaticResource StudioButtonSecondary}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{x:Bind ViewModel.Archive.Entries}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArchiveEntry">
                                        <StackPanel Margin="0,8">
                                            <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Headline}" />
                                            <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind Body}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind Meta}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Style="{StaticResource StudioMuted}"
                                Text="{x:Bind ViewModel.Archive.EmptyHint, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="680"
                    Height="500"
                    Canvas.Left="90"
                    Canvas.Top="44"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="journal"
                    StatusText="{x:Bind ViewModel.Journal.Status, Mode=OneWay}"
                    SubtitleText="Tagged days the twin can retrieve"
                    TitleText="Journal"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Journal">
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="mixer" Text="Choose microphone…" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="twin" Text="Record on Twin" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <Grid Padding="20" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <ComboBox Header="Tag" ItemsSource="{x:Bind ViewModel.Journal.Tags}" SelectedItem="{x:Bind ViewModel.Journal.Tag, Mode=TwoWay}" Width="200" />
                            <TextBox AcceptsReturn="True" Height="90" IsEnabled="{x:Bind ViewModel.Heirs.CanEdit, Mode=OneWay}" PlaceholderText="What was today, really?" Text="{x:Bind ViewModel.Journal.Draft, Mode=TwoWay}" />
                            <Button Command="{x:Bind ViewModel.Journal.FileEntryCommand}" Content="File entry" IsEnabled="{x:Bind ViewModel.Heirs.CanEdit, Mode=OneWay}" Style="{StaticResource StudioButtonPrimary}" />
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Journal.Entries}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArchiveEntry">
                                    <StackPanel Margin="0,8">
                                        <TextBlock Style="{StaticResource StudioCaption}" Text="{x:Bind Headline}" />
                                        <TextBlock Style="{StaticResource StudioText}" Text="{x:Bind Body}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="720"
                    Height="500"
                    Canvas.Left="110"
                    Canvas.Top="30"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="interviewer"
                    StatusText="{x:Bind ViewModel.Interviewer.Progress, Mode=OneWay}"
                    SubtitleText="{x:Bind ViewModel.Interviewer.Status, Mode=OneWay}"
                    TitleText="Interviewer"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Chapter">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Interviewer.PreviousChapterCommand}" Text="Previous" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Interviewer.NextChapterCommand}" Text="Next" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Interviewer.SkipCommand}" Text="Skip" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <StackPanel Padding="28" Spacing="12">
                        <TextBlock Style="{StaticResource StudioWordmark}" Text="{x:Bind ViewModel.Interviewer.ChapterTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StudioMuted}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Interviewer.Prompt, Mode=OneWay}" />
                        <TextBox AcceptsReturn="True" Height="120" PlaceholderText="Answer as you would to someone who will still need you." Text="{x:Bind ViewModel.Interviewer.Answer, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.Interviewer.FileAnswerCommand}" Content="File answer" IsEnabled="{x:Bind ViewModel.Heirs.CanEdit, Mode=OneWay}" Style="{StaticResource StudioButtonPrimary}" />
                            <Button Command="{x:Bind ViewModel.Interviewer.SkipCommand}" Content="Skip" Style="{StaticResource StudioButtonQuiet}" />
                            <Button Command="{x:Bind ViewModel.Interviewer.NextChapterCommand}" Content="Next chapter" Style="{StaticResource StudioButtonSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </controls:StudioDocumentWindow>

                <controls:StudioDocumentWindow
                    Width="700"
                    Height="520"
                    Canvas.Left="70"
                    Canvas.Top="50"
                    Activated="OnDocActivated"
                    CloseRequested="OnDocClose"
                    DocumentId="photos"
                    StatusText="{x:Bind ViewModel.Photos.Status, Mode=OneWay}"
                    SubtitleText="Three facts beat a pretty guess"
                    TitleText="Photos"
                    Visibility="Collapsed">
                    <controls:StudioDocumentWindow.MenuBarContent>
                        <MenuBar>
                            <MenuBarItem Title="Photos">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.Photos.NextQuestionCommand}" Text="Next prompt" />
                                <MenuFlyoutItem Click="OnMenuOpen" Tag="import" Text="Import…" />
                            </MenuBarItem>
                        </MenuBar>
                    </controls:StudioDocumentWindow.MenuBarContent>
                    <Grid Padding="20" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBox Header="Who" PlaceholderText="Names" Text="{x:Bind ViewModel.Photos.Who, Mode=TwoWay}" />
                            <TextBox Header="When" PlaceholderText="Year, season, the day" Text="{x:Bind ViewModel.Photos.When, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource StudioMuted}" Text="{x:Bind ViewModel.Photos.Question, Mode=OneWay}" TextWrapping="Wrap" />
