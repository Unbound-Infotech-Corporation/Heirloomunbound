<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="HeirloomBgBase">#FF121110</Color>
    <Color x:Key="HeirloomBgSurface">#FF1C1A18</Color>
    <Color x:Key="HeirloomBgElevated">#FF262320</Color>
    <Color x:Key="HeirloomText">#FFF2EFE9</Color>
    <Color x:Key="HeirloomTextSecondary">#FFA8A096</Color>
    <Color x:Key="HeirloomTextMuted">#FF7A736B</Color>
    <Color x:Key="HeirloomGold">#FFD4A373</Color>
    <Color x:Key="HeirloomGoldHover">#FFE5B98E</Color>
    <Color x:Key="HeirloomGoldPressed">#FFC08D5C</Color>
    <Color x:Key="HeirloomGoldDeep">#FF8A6238</Color>
    <Color x:Key="HeirloomDanger">#FFA64D4D</Color>
    <Color x:Key="HeirloomBorder">#FF36322E</Color>
    <Color x:Key="HeirloomInk">#FF121110</Color>
    <Color x:Key="HeirloomHighlight">#33FFFFFF</Color>

    <SolidColorBrush x:Key="HeirloomBgBaseBrush" Color="{StaticResource HeirloomBgBase}" />
    <SolidColorBrush x:Key="HeirloomBgSurfaceBrush" Color="{StaticResource HeirloomBgSurface}" />
    <SolidColorBrush x:Key="HeirloomBgElevatedBrush" Color="{StaticResource HeirloomBgElevated}" />
    <SolidColorBrush x:Key="HeirloomTextBrush" Color="{StaticResource HeirloomText}" />
    <SolidColorBrush x:Key="HeirloomTextSecondaryBrush" Color="{StaticResource HeirloomTextSecondary}" />
    <SolidColorBrush x:Key="HeirloomTextMutedBrush" Color="{StaticResource HeirloomTextMuted}" />
    <SolidColorBrush x:Key="HeirloomGoldBrush" Color="{StaticResource HeirloomGold}" />
    <SolidColorBrush x:Key="HeirloomGoldHoverBrush" Color="{StaticResource HeirloomGoldHover}" />
    <SolidColorBrush x:Key="HeirloomGoldPressedBrush" Color="{StaticResource HeirloomGoldPressed}" />
    <SolidColorBrush x:Key="HeirloomDangerBrush" Color="{StaticResource HeirloomDanger}" />
    <SolidColorBrush x:Key="HeirloomBorderBrush" Color="{StaticResource HeirloomBorder}" />
    <SolidColorBrush x:Key="HeirloomInkBrush" Color="{StaticResource HeirloomInk}" />
    <SolidColorBrush x:Key="HeirloomGoldMutedBrush" Color="#26D4A373" />
    <SolidColorBrush x:Key="HeirloomGlassBrush" Color="#CC1C1A18" />

    <FontFamily x:Key="HeirloomSerif">Sitka Display, Georgia, serif</FontFamily>
    <FontFamily x:Key="HeirloomSans">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="HeirloomMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <x:Double x:Key="StudioHairline">1</x:Double>
    <x:Double x:Key="StudioRadius">3</x:Double>
    <CornerRadius x:Key="StudioCorner">3</CornerRadius>
    <Thickness x:Key="StudioButtonPadding">16,8,16,8</Thickness>

    <LinearGradientBrush x:Key="StudioGoldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFE8C49A" />
        <GradientStop Offset="0.45" Color="#FFD4A373" />
        <GradientStop Offset="1" Color="#FFB8844F" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioGoldFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF3D7B4" />
        <GradientStop Offset="0.45" Color="#FFE5B98E" />
        <GradientStop Offset="1" Color="#FFC9995C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioGoldFillPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFC08D5C" />
        <GradientStop Offset="1" Color="#FFA66F3A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioGlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33262320" />
        <GradientStop Offset="1" Color="#66262320" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioInnerHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="0.12" Color="#18FFFFFF" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <Style x:Key="StudioText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSans}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="StudioMuted" TargetType="TextBlock" BasedOn="{StaticResource StudioText}">
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="StudioCaption" TargetType="TextBlock" BasedOn="{StaticResource StudioMuted}">
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="StudioWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSerif}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="CharacterSpacing" Value="-10" />
    </Style>
    <Style x:Key="StudioDocumentTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSerif}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
    </Style>

    <ControlTemplate x:Key="StudioButtonPrimaryTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border
                x:Name="Rim"
                Background="{StaticResource HeirloomGoldDeep}"
                BorderBrush="#FF5C3F1E"
                BorderThickness="1"
                CornerRadius="{StaticResource StudioCorner}">
                <Border
                    x:Name="Face"
                    Margin="0"
                    Background="{StaticResource StudioGoldFill}"
                    BorderBrush="{StaticResource StudioInnerHighlight}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="{StaticResource StudioCorner}">
                    <ContentPresenter
                        x:Name="Content"
                        Margin="{StaticResource StudioButtonPadding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{StaticResource HeirloomSans}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource HeirloomInkBrush}" />
                </Border>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.08" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Face" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StudioGoldFillHover}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Face" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StudioGoldFillPressed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.985"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.985"
                                Duration="0:0:0.08" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="Opacity"
                                To="0.38"
                                Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeirloomGoldHoverBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Thickness>2</Thickness>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="StudioButtonSecondaryTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border
                x:Name="Rim"
                Background="{StaticResource StudioGlassFill}"
                BorderBrush="{StaticResource HeirloomBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource StudioCorner}">
                <Border BorderBrush="{StaticResource StudioInnerHighlight}" BorderThickness="1,1,1,0" CornerRadius="{StaticResource StudioCorner}">
                    <ContentPresenter
                        Margin="{StaticResource StudioButtonPadding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        FontFamily="{StaticResource HeirloomSans}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource HeirloomGoldBrush}" />
                </Border>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeirloomGoldBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.985"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="PressScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.985"
                                Duration="0:0:0.08" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeirloomGoldHoverBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Thickness>2</Thickness>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="StudioButtonQuietTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource StudioCorner}">
                <ContentPresenter
                    Margin="10,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    FontFamily="{StaticResource HeirloomSans}"
                    FontSize="12"
                    Foreground="{StaticResource HeirloomTextSecondaryBrush}" />
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Face" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeirloomGoldMutedBrush}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="StudioButtonDangerTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border
                x:Name="Rim"
                BorderBrush="{StaticResource HeirloomDangerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource StudioCorner}">
                <Border Background="#22A64D4D" BorderBrush="{StaticResource StudioInnerHighlight}" BorderThickness="1,1,1,0" CornerRadius="{StaticResource StudioCorner}">
                    <ContentPresenter
                        Margin="{StaticResource StudioButtonPadding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        FontFamily="{StaticResource HeirloomSans}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FFF0C8C8" />
                </Border>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Rim" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33A64D4D" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="StudioButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HeirloomInkBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource StudioButtonPrimaryTemplate}" />
    </Style>
    <Style x:Key="StudioButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource StudioButtonSecondaryTemplate}" />
    </Style>
    <Style x:Key="StudioButtonQuiet" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource StudioButtonQuietTemplate}" />
    </Style>
    <Style x:Key="StudioButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource StudioButtonDangerTemplate}" />
    </Style>
    <Style x:Key="StudioButtonIcon" TargetType="Button" BasedOn="{StaticResource StudioButtonQuiet}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="StudioSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource HeirloomGoldBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>

    <Style TargetType="MenuBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSans}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HeirloomBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeirloomBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource HeirloomGoldMutedBrush}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HeirloomBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeirloomBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSans}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource HeirloomTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HeirloomSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>
</ResourceDictionary>
