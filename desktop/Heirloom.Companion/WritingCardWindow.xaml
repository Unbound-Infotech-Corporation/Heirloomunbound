<Window
    x:Class="Heirloom.Companion.WritingCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Writing"
    Width="420"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource HlSans}">
    <Border Margin="14" Padding="18,16" Background="#F51C1A18" CornerRadius="12" BorderBrush="{StaticResource HlBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HlGold}" Text="WRITING" />
            <TextBlock Margin="0,10,0,4" FontSize="11" Foreground="{StaticResource HlTextMuted}" Text="Selected" />
            <TextBlock x:Name="Before" Margin="0,0,0,10" Foreground="{StaticResource HlTextSecondary}" FontSize="14" TextWrapping="Wrap" />
            <Border Padding="12,10" CornerRadius="8" Background="{StaticResource HlGoldMuted}" BorderBrush="#55D4A373" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource HlGold}" Text="Shorter" Margin="0,0,0,4" />
                    <TextBlock x:Name="After" Foreground="{StaticResource HlText}" FontFamily="{StaticResource HlSerif}" FontSize="16" LineHeight="22" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="No" Margin="0,0,8,0" Content="Not now" Style="{StaticResource HlGhostButton}" Click="OnNo" />
                <Button x:Name="Yes" Content="Paste" Style="{StaticResource HlGoldButton}" Click="OnYes" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
