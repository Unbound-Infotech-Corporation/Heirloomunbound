<Window
    x:Class="Heirloom.Companion.CaptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Heirloom"
    Width="560"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual">
    <Border Margin="12" Padding="16,12" Background="#F0141414" CornerRadius="8">
        <TextBlock x:Name="Caption" Foreground="White" FontSize="18" TextWrapping="Wrap" />
    </Border>
</Window>
