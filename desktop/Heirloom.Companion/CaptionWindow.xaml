<Window
    x:Class="Heirloom.Companion.CaptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Heirloom"
    Width="560"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual">
    <Border Margin="14" CornerRadius="12" Background="#F2121110" BorderBrush="#5AD4A373" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="3" Margin="0,12,0,12" CornerRadius="2" Background="{StaticResource HlGold}" />
            <StackPanel Margin="14,10,18,12">
                <TextBlock Text="YOUR TWIN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HlGold}" Margin="0,0,0,3" />
                <TextBlock x:Name="Caption" Foreground="{StaticResource HlText}" FontFamily="{StaticResource HlSerif}" FontSize="20" LineHeight="27" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
