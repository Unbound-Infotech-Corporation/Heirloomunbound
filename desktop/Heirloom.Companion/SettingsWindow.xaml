<Window
    x:Class="Heirloom.Companion.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Heirloom Companion"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" >
        <TextBlock FontSize="18" Text="Twin Box" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="The tray shows whether the box is answering. It never restarts the box or this PC." />
        <TextBlock Margin="0,14,0,4" Text="Box address" />
        <TextBox x:Name="Address" />
        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Show the certificate" Click="OnShowCertificate" />
        <TextBlock x:Name="Fingerprint" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="This is my box" Click="OnPin" />
        <TextBlock Margin="0,14,0,4" Text="Owner email" />
        <TextBox x:Name="Email" />
        <TextBlock Margin="0,8,0,4" Text="Password" />
        <PasswordBox x:Name="Password" />
        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Sign in" Click="OnSignIn" />
        <CheckBox x:Name="StartAtLogin" Margin="0,14,0,0" Content="Start at login" />
        <CheckBox x:Name="Toasts" Margin="0,8,0,0" Content="Tell me when the box drops or returns" />
        <CheckBox x:Name="SystemAudio" Margin="0,14,0,0" Content="System audio" />
        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Text="The capture card hears HDMI first. This PC sends speaker loopback only when the card is quiet." />
        <CheckBox x:Name="MicAudio" Margin="0,8,0,0" Content="Microphone" />
        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Text="This PC sends the default microphone. A C920 on the box is used instead when it is plugged in." />
        <TextBlock Margin="0,14,0,4" Text="Twin name" />
        <TextBox x:Name="TwinName" />
        <TextBlock Margin="0,8,0,4" Text="Wake phrase" />
        <TextBox x:Name="WakePhrase" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="Leave the phrase blank to use hey and the twin name. Ctrl+Shift+Space arms the mic for 8 seconds. System audio cannot wake the twin." />
        <CheckBox x:Name="Proactive" Margin="0,8,0,0" Content="Speak up without being asked" />
        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Text="Off unless you check this. Rare, quiet during calls and fullscreen games, and mute from the tray or by saying mute." />
        <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" />
        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Save" Click="OnSave" IsDefault="True" />
    </StackPanel>
</Window>
