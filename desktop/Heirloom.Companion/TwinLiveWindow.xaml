<Window
    x:Class="Heirloom.Companion.TwinLiveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Twin Live"
    Width="360"
    Height="520"
    MinWidth="280"
    MinHeight="240"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    Background="#F4F1EA">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="Status" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Paused" />
            <CheckBox x:Name="OnTop" Content="Always on top" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnTopChanged" Unchecked="OnTopChanged" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#5C564C" Text="Microphone only. The studio can stay closed." />
        <Border x:Name="PendingBox" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" Background="White" CornerRadius="6" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PendingLabel" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="Yes" Content="Yes" MinWidth="72" Padding="12,4" Click="OnYes" />
                    <Button x:Name="No" Content="No" MinWidth="72" Padding="12,4" Margin="8,0,0,0" Click="OnNo" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,4" FontWeight="SemiBold" Text="Receipts" />
        <ScrollViewer DockPanel.Dock="Bottom" Height="88" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Receipts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#3A342C" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Lines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Who}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
