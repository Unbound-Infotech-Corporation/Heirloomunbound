# Plug and unplug of a UVC webcam. The daemon also re-scans /dev/video*
# each loop, so a replug is picked up even when systemd does not restart it.
# += keeps the Observer rule's SYSTEMD_WANTS value, which is assigned first.
ACTION=="add", SUBSYSTEM=="video4linux", TAG+="systemd", ENV{SYSTEMD_WANTS}+="heirloom-presence.service"
