# Real directories only. /run/heirloom-observer is a symlink, never a second directory.
d /run/heirloom 0755 root root -
d /run/heirloom/observer 0755 root root -
d /run/heirloom/observer/audio 0775 root root -
d /run/heirloom/observer/audio/system 0775 root root -
d /run/heirloom/observer/audio/mic 0775 root root -
d /run/heirloom/observer/screen 0775 root root -
L /run/heirloom-observer - - - - /run/heirloom/observer
