#!/usr/bin/env bash
# Host-side launcher for the Observer daemon. The repo root is recorded by box/install.sh.
if [[ -z "${BASH_VERSION:-}" ]]; then
  echo "heirloom-observer requires bash." >&2
  exit 1
fi
set -euo pipefail

if [[ ! -r /etc/heirloom/root ]]; then
  echo "Missing /etc/heirloom/root. Run box/install.sh first." >&2
  exit 1
fi
ROOT="$(tr -d '[:space:]' < /etc/heirloom/root)"
if [[ ! -f "${ROOT}/box/observer/observerd.py" ]]; then
  echo "Observer daemon is not in ${ROOT}." >&2
  exit 1
fi
export PYTHONPATH="${ROOT}/backend${PYTHONPATH:+:${PYTHONPATH}}"
exec /usr/bin/python3 "${ROOT}/box/observer/observerd.py"
