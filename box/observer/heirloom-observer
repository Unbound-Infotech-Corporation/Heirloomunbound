#!/usr/bin/env bash
# Host-side launcher for the Observer daemon. The repo root is recorded by box/install.sh.
if [[ -z "${BASH_VERSION:-}" ]]; then
  echo "heirloom-observer requires bash." >&2
  exit 1
fi
set -euo pipefail

if [[ ! -r /etc/heirloom/root ]]; then
  echo "Missing /etc/heirloom/root. Run box/install.sh first." >&2
  exit 1
fi
ROOT="$(tr -d '[:space:]' < /etc/heirloom/root)"
if [[ ! -f "${ROOT}/box/observer/observerd.py" ]]; then
  echo "Observer daemon is not in ${ROOT}." >&2
  exit 1
fi
export PYTHONPATH="${ROOT}/backend${PYTHONPATH:+:${PYTHONPATH}}"
DATA_ROOT=""
if [[ -r /etc/heirloom/data-root ]]; then
  DATA_ROOT="$(tr -d '[:space:]' < /etc/heirloom/data-root)"
fi
if [[ -z "${DATA_ROOT}" ]]; then
  DATA_ROOT="/var/lib/heirloom"
fi
PY="/usr/bin/python3"
if [[ -x "${DATA_ROOT}/observer/venv/bin/python" ]]; then
  PY="${DATA_ROOT}/observer/venv/bin/python"
fi
# CUDA 13 does not ship libcublas.so.12. The pip wheels live in the venv.
if [[ -x "${PY}" ]]; then
  SITE="$("${PY}" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])' 2>/dev/null || true)"
  LIB_PATHS=()
  for dir in "${SITE}/nvidia/cublas/lib" "${SITE}/nvidia/cudnn/lib"; do
    if [[ -n "${SITE}" && -d "${dir}" ]]; then
      LIB_PATHS+=("${dir}")
    fi
  done
  if [[ ${#LIB_PATHS[@]} -gt 0 ]]; then
    joined="$(IFS=:; echo "${LIB_PATHS[*]}")"
    export LD_LIBRARY_PATH="${joined}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
  fi
fi
exec "${PY}" "${ROOT}/box/observer/observerd.py"
