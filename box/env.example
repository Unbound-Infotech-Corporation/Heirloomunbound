# Copied to $HEIRLOOM_DATA_ROOT/box.env by box/install.sh (default /var/lib/heirloom).
# HEIRLOOM_DATA_ROOT=/var/lib/heirloom
# HEIRLOOM_LAN_IP=192.168.0.111
# HEIRLOOM_GPU_NAME=NVIDIA GeForce RTX 3090
# Do not commit a real CONNECTOR_SECRET_KEY, GITHUB_TOKEN, or mailbox password.
MONGO_URL=mongodb://mongo:27017
DB_NAME=heirloom
HEIRLOOM_BOX=1
HEIRLOOM_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Optional primary brain on the LAN (BIGDEAL). Tried first; this box is the fallback.
# Set with: sudo bash box/install.sh --brain-url http://192.168.0.50:11434
# HEIRLOOM_BRAIN_URL=http://192.168.0.50:11434
# HEIRLOOM_BRAIN_MODEL=llama3.3:70b
# Optional Bearer token for a LAN proxy in front of Ollama. Never put it in the URL.
# HEIRLOOM_BRAIN_TOKEN=
# Installer overwrites this from VRAM. With --observer on the RTX 3090 it is qwen2.5:14b.
OLLAMA_TWIN_MODEL=qwen2.5:7b
HEIRLOOM_LAB_MODE=1
HEIRLOOM_LAB_DIR=/var/lib/heirloom/lab
HEIRLOOM_LAB_REPORT_DIR=/var/lib/heirloom/lab-reports
HEIRLOOM_AI_DISCLOSURE=1
# Optional. Leave unset and the nightly report stays on disk.
# GITHUB_TOKEN=
# HEIRLOOM_LAB_GITHUB_REPO=owner/repo
CONNECTOR_SECRET_KEY=replace-with-a-long-local-passphrase
# Observer stays off unless the lab installer was run with --observer.
# HEIRLOOM_OBSERVER=1
# HEIRLOOM_OBSERVER_DIR=/var/lib/heirloom/observer
# OBSERVER_OLLAMA_URL=http://127.0.0.1:11434
# OBSERVER_SAMPLE_FPS=2
# OBSERVER_BURST_FPS=8
# Picture source: auto (companion JPEG when it is fresh, else /dev/video0), network, or capture.
# OBSERVER_SOURCE=auto
# OBSERVER_NETWORK_FRESH_S=3
# OBSERVER_SCREEN_SPOOL=/run/heirloom-observer/screen
# OBSERVER_CLIPS=0
# OBSERVER_CLIP_SECONDS=8
# OBSERVER_CLIP_MAX_MINUTES_PER_DAY=10
# OBSERVER_CLIP_TTL_DAYS=7
# OBSERVER_DISK_CAP_BYTES=536870912
# OBSERVER_HOTKEY_PHRASE=HEIRLOOM PAUSE
# OBSERVER_QUIET_HOURS=23:00-07:00
# OBSERVER_VRAM_MIB=24576
# Reference pair for an RTX 3090 (24 GB) beside the chat model. See box/OBSERVER.md.
# OLLAMA_TWIN_MODEL=qwen2.5:14b
# OLLAMA_OBSERVER_MODEL=qwen2.5vl:7b
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=30m
# OBSERVER_VISION_KEEP_ALIVE=45s
# OBSERVER_RING_SLOTS=4
# OBSERVER_RAM_BUDGET_BYTES=67108864
# Presence stays off unless the lab installer was run with --presence.
# USB webcams, YuNet (MIT) + SFace (Apache-2.0). See box/PRESENCE.md.
# HEIRLOOM_PRESENCE=1
# HEIRLOOM_PRESENCE_DIR=/var/lib/heirloom/presence
# PRESENCE_FPS=3
# PRESENCE_VRAM_BUDGET_MIB=512
# PRESENCE_THRESHOLD=0.36
# PRESENCE_DEBOUNCE_MINUTES=10
# PRESENCE_UNKNOWN_THUMBNAILS=0
# PRESENCE_SPEAK=0
# PRESENCE_SPEAK_URL=http://127.0.0.1:8010/speak
# PRESENCE_QUIET_HOURS=23:00-07:00
