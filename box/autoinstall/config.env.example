# Heirloom Twin Box autoinstall configuration.
# Copy this file to box/autoinstall/config.env and fill it in before building the USB.
# config.env is not committed. It can contain a Tailscale key.
#
# BOOT THIS USB ONLY ON THE TWIN BOX.
# The installer erases the one internal disk whose serial matches TARGET_DISK_SERIAL.
# An empty serial, a serial that matches nothing, more than one match, a USB disk,
# or the boot stick itself aborts the install and does not erase anything.

# Required. From the Twin Box, before you install:
#   lsblk -d -o NAME,MODEL,SIZE,SERIAL,TRAN,RM
# Use the SERIAL of the internal system disk (RM=0, TRAN is sata or nvme, not usb).
# On Windows, an Administrator PowerShell shows the same disks:
#   Get-Disk | Select-Object Number,FriendlyName,SerialNumber,BusType
TARGET_DISK_SERIAL=

# Installed system identity.
HOSTNAME=heirloom-twinbox
USERNAME=heirloom

# Password for the local account and, if SSH_PASSWORD_AUTH=yes, for SSH.
# The build hashes this and does not copy the plain password onto the ISO.
# Leave it empty only when SSH_AUTHORIZED_KEYS_FILE contains a key.
INITIAL_PASSWORD=

# Or paste a precomputed SHA-512 crypt hash from: openssl passwd -6
PASSWORD_HASH=

# yes keeps password SSH login. no allows public-key login only.
# no requires at least one key in SSH_AUTHORIZED_KEYS_FILE.
SSH_PASSWORD_AUTH=yes
SSH_AUTHORIZED_KEYS_FILE=box/autoinstall/authorized_keys

# NVIDIA production branch from the official CUDA apt repo (Ubuntu 24.04).
# latest installs nvidia-open with no pinning package.
# A branch such as 580 installs nvidia-driver-pinning-580 first, then nvidia-open.
# The RTX 3090 uses the open kernel modules. proprietary selects cuda-drivers instead.
NVIDIA_DRIVER_BRANCH=latest
NVIDIA_KERNEL_MODULES=open

# nvidia-smi must report this text before Heirloom is installed. The Twin Box is a 3090.
EXPECTED_GPU_NAME=3090

# Optional. When set, first boot runs tailscale up with this key and the box joins
# your tailnet by itself. The key is on the USB. Keep the stick private.
TAILSCALE_AUTH_KEY=

# Where first boot gets Heirloom. Set a git URL, or put a tarball at
# box/autoinstall/payload/heirloom.tar.gz (the archive must contain box/install.sh).
HEIRLOOM_REPO_URL=
HEIRLOOM_REPO_REF=main
HEIRLOOM_PAYLOAD=

# Installer language. Leave these unless the keyboard layout is wrong.
LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us
TIMEZONE=UTC

# Official Ubuntu Server 24.04 live ISO. build-usb.sh checks this SHA256.
UBUNTU_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.5-live-server-amd64.iso
UBUNTU_ISO_SHA256=97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8
UBUNTU_ISO_NAME=ubuntu-24.04.5-live-server-amd64.iso
