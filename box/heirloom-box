#!/usr/bin/env bash
# Twin Box status, backup, and lab report.
if [[ -z "${BASH_VERSION:-}" ]]; then
  echo "heirloom-box requires bash." >&2
  exit 1
fi
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: heirloom-box <status|backup|report|observer|presence|update-drivers|set-owner>

  status             services, GPU, disk, observer, presence, last backup, last report, /api/health
  backup             Mongo archive + vault tarball, 14 copies kept
  report             nightly local markdown under the data root's lab-reports
  set-owner EMAIL    set the owner email and password (password read from the prompt, not saved in the log)
  update-drivers     install or upgrade the CUDA-repo NVIDIA driver, CUDA toolkit, cuDNN, nvtop, and the container toolkit
                     add --dry-run to print the plan
  observer status    capture device, signal, fps, model, pause, notes today, disk used
  observer pause     stop understanding until resume (also pauses Presence)
  observer resume    clear a manual, web, or hotkey pause
  observer digest    write today's learned-notes markdown
  presence status    cameras, fps, people enrolled, who is here, pause
  presence pause     stop recognition until resume (also pauses Observer)
  presence resume    clear the shared pause
  presence forget    delete every enrolled face on this box
EOF
}

data_root() {
  if [[ -r /etc/heirloom/data-root ]]; then
    tr -d '[:space:]' < /etc/heirloom/data-root
    return 0
  fi
  printf '%s\n' "${HEIRLOOM_DATA_ROOT:-/var/lib/heirloom}"
}

source_box_env_lib() {
  local root lib
  root="$(read_root)"
  lib=""
  if [[ -n "${root}" && -f "${root}/box/lib/box-env.sh" ]]; then
    lib="${root}/box/lib/box-env.sh"
  elif [[ -f /usr/local/lib/heirloom/box-env.sh ]]; then
    lib="/usr/local/lib/heirloom/box-env.sh"
  fi
  if [[ -z "${lib}" ]]; then
    return 1
  fi
  # shellcheck source=lib/box-env.sh
  source "${lib}"
}

read_root() {
  if [[ -r /etc/heirloom/root ]]; then
    tr -d '[:space:]' < /etc/heirloom/root
    return 0
  fi
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "${here}/docker-compose.yml" ]]; then
    cd "${here}/.." && pwd
    return 0
  fi
  printf '%s\n' ""
}

export_compose_env() {
  local root ip
  root="$(data_root)"
  export HEIRLOOM_DATA_ROOT="${root}"
  ip=""
  if [[ -r "${root}/box.env" ]]; then
    ip="$(awk -F= '/^HEIRLOOM_LAN_IP=/{val=substr($0, index($0, "=") + 1)} END {print val}' "${root}/box.env")"
  fi
  ip="${ip//$'\r'/}"
  export HEIRLOOM_LAN_IP="${ip:-${HEIRLOOM_LAN_IP:-127.0.0.1}}"
}

compose() {
  local root="$1"
  shift
  local -a args=()
  export_compose_env
  if [[ -r /etc/heirloom/compose.env ]]; then
    args+=(--env-file /etc/heirloom/compose.env)
  fi
  if [[ -r /etc/heirloom/compose.args ]]; then
    local line
    while IFS= read -r line; do
      [[ -n "${line}" ]] && args+=("${line}")
    done < /etc/heirloom/compose.args
  else
    args+=(-f "${root}/box/docker-compose.yml")
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf 'docker compose is not installed\n' >&2
    return 1
  fi
  docker compose "${args[@]}" "$@"
}

cmd_status() {
  local root
  root="$(read_root)"
  printf 'Heirloom Twin Box\n'
  printf 'root: %s\n' "${root:-unset}"

  printf '\n## services\n'
  if [[ -n "${root}" ]] && command -v docker >/dev/null 2>&1; then
    compose "${root}" ps || printf 'compose ps failed\n'
  else
    printf 'docker or install root is not available\n'
  fi

  printf '\n## gpu\n'
  if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null; then
    true
  else
    printf 'no NVIDIA GPU answering nvidia-smi\n'
  fi

  local data
  data="$(data_root)"
  printf '\n## disk\n'
  if [[ -d "${data}" ]]; then
    df -h "${data}" || true
  else
    printf '%s is not created yet\n' "${data}"
  fi

  printf '\n## last backup\n'
  local last=""
  if [[ -d "${data}/backups" ]]; then
    last="$(find "${data}/backups" -mindepth 1 -maxdepth 1 -type d | sort | tail -n 1 || true)"
  fi
  if [[ -n "${last}" ]]; then
    printf '%s\n' "${last}"
  else
    printf 'none\n'
  fi

  printf '\n## last report\n'
  local report=""
  if [[ -d "${data}/lab-reports" ]]; then
    report="$(find "${data}/lab-reports" -maxdepth 1 -name 'lab-report-*.md' | sort | tail -n 1 || true)"
  fi
  if [[ -n "${report}" ]]; then
    printf '%s\n' "${report}"
  else
    printf 'none\n'
  fi

  printf '\n## observer\n'
  print_observer "${root}"

  printf '\n## presence\n'
  print_presence "${root}"

  printf '\n## health\n'
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 5 http://127.0.0.1:8001/api/health \
      || curl -kfsS --max-time 5 https://127.0.0.1/api/health \
      || printf 'health endpoint did not answer\n'
    printf '\n'
  else
    printf 'curl is not installed\n'
  fi
}

run_box_python() {
  local root="$1"
  local module="$2"
  shift 2
  local env_file
  env_file="$(data_root)/box.env"
  (
    if source_box_env_lib; then
      load_box_env "${env_file}"
    fi
    # PYTHONPATH is only for this python process.
    # shellcheck disable=SC2030
    export PYTHONPATH="${root}/backend${PYTHONPATH:+:${PYTHONPATH}}"
    python3 -m "${module}" "$@"
  )
}

print_observer() {
  local root="$1"
  if [[ -z "${root}" || ! -f "${root}/backend/observer_cli.py" ]]; then
    printf 'observer module is not in the install root\n'
    return 0
  fi
  run_box_python "${root}" observer_cli status \
    || printf 'observer status failed\n'
}

print_presence() {
  local root="$1"
  if [[ -z "${root}" || ! -f "${root}/backend/presence_cli.py" ]]; then
    printf 'presence module is not in the install root\n'
    return 0
  fi
  run_box_python "${root}" presence_cli status \
    || printf 'presence status failed\n'
}

cmd_presence() {
  local action="${1:-}"
  local root
  root="$(read_root)"
  case "${action}" in
    status|pause|resume|forget) ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  if [[ -z "${root}" || ! -f "${root}/backend/presence_cli.py" ]]; then
    echo "Run box/install.sh before heirloom-box presence." >&2
    exit 1
  fi
  run_box_python "${root}" presence_cli "${action}"
}

cmd_observer() {
  local action="${1:-}"
  local root
  root="$(read_root)"
  case "${action}" in
    status|pause|resume|digest) ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  if [[ -z "${root}" || ! -f "${root}/backend/observer_cli.py" ]]; then
    echo "Run box/install.sh before heirloom-box observer." >&2
    exit 1
  fi
  run_box_python "${root}" observer_cli "${action}"
}

cmd_backup() {
  local root stamp dest
  root="$(read_root)"
  if [[ -z "${root}" ]]; then
    echo "Run box/install.sh before heirloom-box backup." >&2
    exit 1
  fi
  local data
  data="$(data_root)"
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  dest="${data}/backups/${stamp}"
  mkdir -p "${dest}"
  compose "${root}" exec -T mongo mongodump --archive > "${dest}/mongo.archive"
  if [[ -d "${data}/vault" ]]; then
    tar -C "${data}" -czf "${dest}/vault.tgz" vault
  else
    printf 'vault directory missing\n' > "${dest}/vault-missing.txt"
  fi
  mapfile -t old < <(find "${data}/backups" -mindepth 1 -maxdepth 1 -type d | sort | head -n -14 || true)
  local dir
  for dir in "${old[@]+"${old[@]}"}"; do
    rm -rf "${dir}"
  done
  printf '%s\n' "${dest}"
}

cmd_update_drivers() {
  local dry=0
  if [[ "${1:-}" == "--dry-run" ]]; then
    dry=1
  elif [[ -n "${1:-}" ]]; then
    usage >&2
    exit 2
  fi
  local root script
  root="$(read_root)"
  script=""
  if [[ -n "${root}" && -f "${root}/box/lib/nvidia-stack.sh" ]]; then
    script="${root}/box/lib/nvidia-stack.sh"
  elif [[ -f /usr/local/lib/heirloom/nvidia-stack.sh ]]; then
    script="/usr/local/lib/heirloom/nvidia-stack.sh"
  else
    echo "nvidia-stack.sh was not found. Run box/install.sh from a checkout of this repo." >&2
    exit 1
  fi
  local -a args=(--upgrade)
  if [[ "${dry}" -eq 1 ]]; then
    args+=(--dry-run)
  elif [[ "${EUID}" -ne 0 ]]; then
    echo "Re-run as root: sudo heirloom-box update-drivers" >&2
    exit 1
  fi
  bash "${script}" "${args[@]}"
  if [[ "${dry}" -eq 0 ]] && [[ -f /var/run/reboot-required || -f /run/heirloom-nvidia-reboot-needed ]]; then
    printf '%s\n' "Reboot to load the new NVIDIA driver, then run: nvidia-smi"
  fi
}

owner_secret_lib() {
  local root="${1:-}"
  if [[ -n "${root}" && -f "${root}/box/lib/owner-secret.sh" ]]; then
    printf '%s\n' "${root}/box/lib/owner-secret.sh"
    return 0
  fi
  if [[ -f /usr/local/lib/heirloom/owner-secret.sh ]]; then
    printf '%s\n' /usr/local/lib/heirloom/owner-secret.sh
    return 0
  fi
  printf '%s\n' ""
}

cmd_set_owner() {
  local email="${1:-}"
  local root data password lib owner_file
  root="$(read_root)"
  data="$(data_root)"
  if [[ -z "${email}" || "${email}" != *@* ]]; then
    echo "Usage: heirloom-box set-owner you@example.com" >&2
    exit 2
  fi
  if [[ -z "${root}" || ! -f "${root}/backend/box_owner.py" ]]; then
    echo "Run box/install.sh before heirloom-box set-owner." >&2
    exit 1
  fi
  lib="$(owner_secret_lib "${root}")"
  if [[ -z "${lib}" ]]; then
    echo "owner-secret.sh was not found. Run box/install.sh from a checkout of this repo." >&2
    exit 1
  fi
  # shellcheck source=lib/owner-secret.sh
  source "${lib}"
  if ! ensure_owner_secret "${data}"; then
    exit 1
  fi
  owner_file="$(owner_password_file "${data}")"
  if [[ -t 0 ]]; then
    read -r -s -p "Owner password (8 or more characters): " password
    printf '\n'
  else
    IFS= read -r password
  fi
  # shellcheck disable=SC2031
  printf '%s' "${password}" | HEIRLOOM_OWNER_PASSWORD_FILE="${owner_file}" HEIRLOOM_DATA_ROOT="${data}" \
    PYTHONPATH="${root}/backend${PYTHONPATH:+:${PYTHONPATH}}" \
    python3 -m box_owner set "${email}"
  password=""
}

cmd_report() {
  local root
  root="$(read_root)"
  if [[ -z "${root}" ]]; then
    echo "Run box/install.sh before heirloom-box report." >&2
    exit 1
  fi
  compose "${root}" exec -T api python -m lab_report
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    status) cmd_status ;;
    backup) cmd_backup ;;
    report) cmd_report ;;
    observer)
      shift
      cmd_observer "${1:-}"
      ;;
    presence)
      shift
      cmd_presence "${1:-}"
      ;;
    update-drivers)
      shift
      cmd_update_drivers "${1:-}"
      ;;
    set-owner)
      shift
      cmd_set_owner "${1:-}"
      ;;
    -h|--help|help|"") usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
